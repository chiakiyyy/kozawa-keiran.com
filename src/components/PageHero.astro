---
import { dim } from '../data/imgsize';
// 下層ページ共通のヒーロー（切り欠き付きの大きな写真）
interface Props {
  en: string;          // 例: Service
  ja: string;          // 例: 事業内容
  img?: string;
  alt?: string;
  pos?: string;
  lead?: string;
}
const { en, ja, img, alt = '', pos = 'center', lead } = Astro.props;
---
<section class="hf">
  {img ? (
    <div class="hf-img">
      <img src={img} {...dim(img)} alt={alt} loading="eager" style={`object-position:${pos}`}/>
      <div class="hf-title">
        <h1>{ja}</h1>
      </div>
    </div>
  ) : (
    <div class="hf-plain">
      <h1>{ja}</h1>
    </div>
  )}
  {lead && <p class="hf-lead">{lead}</p>}
  <slot/>
</section>

<style>
.hf-plain { border-radius: var(--notch-r); background: var(--butter); padding: clamp(2.5rem, 7vw, 5rem) 2rem; text-align: center; }
.hf-plain h1 { margin: 0; font-family: 'Zen Kaku Gothic New', Manrope, sans-serif; font-weight: 700; letter-spacing: .08em; font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1.2; color: var(--on-brand); }
.hf-plain .hf-ja { display: block; margin: .6rem 0 0; font-family: 'Zen Kaku Gothic New', sans-serif; font-size: 1rem; letter-spacing: .15em; color: var(--on-brand); }
.hf-lead { max-width: 760px; margin: 2.5rem auto 1rem; padding: 0 1rem; text-align: center; font-size: 1.03rem; line-height: 2.2; letter-spacing: .06em; color: var(--muted); }
@media (max-width: 640px) { .hf-lead { text-align: left; } }
</style>
