---
const linksRow1 = [
  { label: '私たちについて', href: '/about' },
  { label: '商品紹介',       href: '/products' },
  { label: '直売所のご案内', href: '/store' },
  { label: 'オンラインショップ', href: '/gift' },
  { label: '送料とお届け',   href: '/delivery' },
];
const linksRow2 = [
  { label: '法人のお客様',   href: '/business' },
  { label: '実績',           href: '/works' },
  { label: 'プライバシーポリシー', href: '/privacy' },
];
---
<footer class="ft">
  <div class="ft-top">
    <div class="ft-in">
      <div class="ft-brand">
        <a href="/" class="ft-logo">
          <span class="ft-blob"><img src="/images/logo-mark.png" alt="" aria-hidden="true" class="ft-logo-icon"/></span>
          <div>
            <span class="ft-jp">小澤鶏卵</span>
            <span class="ft-en">KOZAWA KEIRAN</span>
          </div>
        </a>
        <a href="tel:076-466-3815" class="ft-tel">076-466-3815</a>
        <p class="ft-hrs">月〜土 8:00〜17:00（日祝休業）<br/>〒939-2716 富山県富山市婦中町下轡田25-1</p>
      </div>

      <nav class="ft-nav" aria-label="フッターナビゲーション">
        <ul class="ft-nav-row">
          {linksRow1.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <ul class="ft-nav-row">
          {linksRow2.map(l => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/contact" class="ft-btn-primary">お問い合わせはこちら →</a></li>
        </ul>
      </nav>
    </div>
  </div>
  <div class="ft-btm">
    <p>&copy; {new Date().getFullYear()} 小澤鶏卵 All rights reserved.</p>
  </div>
</footer>

<style>
.ft { background: var(--brand); color: #5A401A; }
.ft-top { padding: 1.75rem 0 1.25rem; }
.ft-in {
  max-width: 1200px; margin: 0 auto; padding: 0 2rem;
  display: flex; align-items: center; justify-content: space-between; gap: 2rem;
  flex-wrap: wrap;
}
.ft-brand { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
.ft-logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; flex-shrink: 0; }
.ft-blob { display: flex; align-items: center; justify-content: center; width: 64px; height: 54px; background: #fff; border-radius: 58% 42% 55% 45% / 52% 60% 40% 48%; flex-shrink: 0; }
.ft-logo-icon { height: 38px; width: auto; display: block; object-fit: contain; }
.ft-jp { display: block; font-family: 'Zen Kaku Gothic New', sans-serif; font-size: 1.05rem; font-weight: 700; color: #4A3313; letter-spacing: .05em; line-height: 1.3; }
.ft-en { display: block; font-family: Manrope, sans-serif; font-size: .75rem; letter-spacing: .2em; color: #5A401A; margin-top: 2px; }
.ft-tel { font-family: Manrope, sans-serif; font-size: 1.15rem; font-weight: 700; color: #4A3313; text-decoration: none; letter-spacing: .03em; flex-shrink: 0; }
.ft-hrs { font-size: .9rem; color: #5A401A; margin: 0; line-height: 1.5; }

/* メニュー：横並び2行 */
.ft-nav { flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: .4rem; }
.ft-nav-row {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; justify-content: center;
}
.ft-nav a {
  font-size: .92rem; color: #4A3313;
  text-decoration: none; padding: .25rem 0;
  transition: color .15s;
  white-space: nowrap;
}
.ft-nav a:hover { color: #000; text-decoration: underline; }

.ft-nav a.ft-btn-primary,
.ft-btn-primary {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .85rem 1.7rem !important; border-radius: 999px;
  background:#5A401A; color:#fff !important;
  font-family: Manrope, 'Zen Kaku Gothic New', sans-serif;
  font-size: 1rem; font-weight: 700; letter-spacing: .06em;
  text-decoration: none; border: none; cursor: pointer;
  box-shadow: 0 4px 14px rgba(90,64,26,0.22);
  transition: all .28s cubic-bezier(.25,.46,.45,.94); white-space: nowrap;
}
.ft-nav a.ft-btn-primary:hover,
.ft-btn-primary:hover { background: #4A3313; color: #fff !important; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.35); text-decoration: none; }

.ft-btm {
  border-top: 0.5px solid rgba(90,64,26,0.25);
  padding: .75rem 2rem; text-align: center;
}
.ft-btm p { font-size: .9rem; color: #5A401A; margin: 0; }

@media (max-width:900px) {
  .ft-in { flex-direction: column; align-items: stretch; text-align: center; gap: 1.25rem; }
  .ft-brand { justify-content: center; }
  .ft-nav-row { justify-content: center; }
}
@media (max-width:600px) {
  .ft-brand { flex-direction: column; gap: .75rem; text-align: center; }
}
</style>
