---
import { processSteps } from '../data/commitment';

const points = [
  {
    num: '01',
    img: '/images/feature/feature-chickens.jpg',
    fallback: false,
    ja: '健康な鶏から、健康なたまごを',
    body: '鶏の健康を第一に考え、衛生管理を徹底した環境で飼育しています。飼料にもこだわり、栄養バランスのとれた食事で、元気な鶏を育てています。',
    icon: `<svg width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="#5A401A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 26c0-7 3-13 7-13s7 6 7 13"/><circle cx="17" cy="9" r="5"/><path d="M21 7l4-2-1 4"/><path d="M14 8l-1.5-1.5"/></svg>`,
  },
  {
    num: '02',
    img: '/images/feature/feature-egg.jpg',
    fallback: false,
    ja: '新鮮さをそのままに',
    body: '毎日、丁寧に集卵し、鮮度を保ったまま出荷しています。卵本来のコクと甘みを、ぜひご賞味ください。',
    icon: `<svg width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="#5A401A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="17" cy="19" rx="10" ry="12"/><path d="M17 7V4"/></svg>`,
  },
  {
    num: '03',
    img: '/images/feature/feature-factory.jpg',
    fallback: false,
    ja: '徹底した品質管理',
    body: '洗卵・選別・検査・包装まで、すべての工程で厳しい基準を設け、安心・安全な卵をお届けできるよう、品質管理を徹底しています。',
    icon: `<svg width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="#5A401A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="6" width="16" height="22" rx="2"/><path d="M13 13h8M13 18h8M13 23h5"/></svg>`,
  },
  {
    num: '04',
    img: '/images/business_hero.png',
    fallback: false,
    ja: '迅速・丁寧な配送',
    body: '富山県内を中心に、毎日新鮮な卵をお届けしています。ご希望の時間・数量に合わせて、柔軟に対応いたします。',
    icon: `<svg width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="#5A401A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="17" height="11" rx="1.5"/><path d="M20 14h6l4 5v3h-10v-8z"/><circle cx="9" cy="25" r="2.4"/><circle cx="25" cy="25" r="2.4"/></svg>`,
  },
  {
    num: '05',
    img: '/images/feature/feature-family.jpg',
    fallback: false,
    ja: '地域の食卓を支える存在へ',
    body: '地元に根ざした鶏卵の生産・販売を通じて、地域の皆さまの「おいしい」を支え続けていきます。',
    icon: `<svg width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="#5A401A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="9" r="3.2"/><circle cx="23" cy="9" r="3.2"/><path d="M5 27v-4a6 6 0 016-6h0a6 6 0 016 6v4"/><path d="M17 27v-4a6 6 0 016-6h0a6 6 0 016 6v4"/></svg>`,
  },
];
---
    <!-- 5つのこだわり -->
    <section class="fe-points" id="feature">
      <div class="container">
        <div class="ttl"><h2 class="ttl-en">おいしさと安心のための 5つのこだわり</h2></div>

        <div class="fe-list">
          {points.map(p => (
            <div class="fe-row">
              <div class:list={["fe-row-img", { "img-fallback": p.fallback }]}>
                <img src={p.img} alt={p.ja} loading="lazy" onerror="this.closest('.fe-row-img').classList.add('img-fallback')"/>
              </div>
              <div class="fe-row-icon" set:html={p.icon}></div>
              <div class="fe-row-body">
                <span class="fe-row-num">{p.num}</span>
                <h3>{p.ja}</h3>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 出荷までの流れ（旧 /flow を統合） -->
    <section class="fe-process" id="process">
      <div class="container">
        <div class="ttl"><h2 class="ttl-en">採卵から食卓へ・出荷までの流れ</h2></div>
        <ol class="fe-steps">
          {processSteps.map(st => (
            <li><span>{st.num}</span><div><h3>{st.title}</h3><p>{st.body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

<style>
.fe-process { padding: 5.5rem 0; background: var(--panel); }
.fe-steps { list-style: none; margin: 0 auto; padding: 0; max-width: 960px; display: grid; gap: 1rem; }
.fe-steps li { display: flex; gap: 1.5rem; align-items: center; background: #fff; border-radius: 16px; padding: 1.2rem 1.8rem; border: .5px solid var(--border); }
.fe-steps li > span { font-family: Manrope, sans-serif; font-size: 1.5rem; font-weight: 300; color: var(--amber); min-width: 2.2rem; }
.fe-steps h3 { margin: 0 0 .2rem; font-size: 1rem; }
.fe-steps p { margin: 0; font-size: 1rem; color: var(--muted); }
.fe-points { padding:5rem 0 5.5rem; background: var(--bg); }
.fe-points-head { text-align:center; margin-bottom:3.5rem; }
.fe-points-head h2 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:clamp(1.3rem,2.6vw,1.7rem); font-weight:700; color:#5A401A; }
.fe-points-line { display:block; width:2.5rem; height:2px; background:var(--brand); margin:1.1rem auto 0; }
.fe-list { display:flex; flex-direction:column; gap:2.25rem; }
.fe-row {
.fe-row-img { width:320px; height:230px; border-radius:14px; overflow:hidden; flex-shrink:0; margin-left:0; }
.fe-row-img img { width:100%; height:100%; object-fit:cover; display:block; }
.fe-row-img.img-fallback { background:linear-gradient(135deg,#FAEEDA,#F2C97A); display:flex; align-items:center; justify-content:center; }
.fe-row-img.img-fallback img { display:none; }
.fe-row-icon {
.fe-row-body { padding-left:2.5rem; }
.fe-row-num { font-family:Manrope,sans-serif; font-size:1.5rem; font-weight:700; color:#5A401A; letter-spacing:.02em; display:block; margin-bottom:.35rem; }
.fe-row-body h3 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.2rem; font-weight:700; color:#5A401A; margin-bottom:.6rem; }
.fe-row-body p { font-size:1rem; color:#7A6544; line-height:1.85; margin:0; max-width:560px; }
@media (max-width:1024px) {
  .fe-row { grid-template-columns:1fr; padding:1.75rem; }
  .fe-row-img { width:100%; height:220px; }
  .fe-row-icon { position:static; transform:none; margin-bottom:1rem; }
  .fe-row-body { padding-left:0; }
}
.fe-points .container, .fe-process .container { max-width:1200px; margin:0 auto; padding:0 2rem; }
.fe-points { padding:96px 0; background: var(--bg); }
.fe-process { padding:96px 0; background: var(--panel); }
</style>
