---
const nav = [
  { en: 'ABOUT',  ja: '私たちについて',     href: '/about' },
  { en: 'LINE UP', ja: '商品紹介',          href: '/products' },
  { en: 'BUSINESS', ja: '法人のお客様',     href: '/business' },
  { en: 'SHOP',   ja: 'オンラインショップ', href: '/gift' },
];
// ドロワーのみに表示する項目
const navMore = [
  { en: 'CONTACT', ja: 'お問い合わせ',   href: '/contact' },
  { en: 'STORE',   ja: '直売所のご案内', href: '/store' },
  { en: 'DELIVERY', ja: '送料とお届け', href: '/delivery' },
];
const path = Astro.url.pathname;
---

<header class="hdr" id="hdr">
  <a href="/" class="hdr-brand" aria-label="小澤鶏卵 トップへ">
    <span class="hdr-blob"><img src="/images/logo-mark.png" alt="" aria-hidden="true" class="hdr-logo-icon" width="40" height="40"/></span>
    <span>
      <span class="logo-jp">小澤鶏卵</span>
      <span class="logo-en">KOZAWA KEIRAN</span>
    </span>
  </a>
  <div class="hdr-right">
    <nav class="hdr-nav" aria-label="メインナビゲーション">
      <ul>
        {nav.map(item => (
          <li><a href={item.href} class={`${path.startsWith(item.href) ? 'act' : ''}${item.biz ? ' gift' : ''}`}>{item.ja}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/contact" class={`hdr-biz${path.startsWith('/contact') ? ' act' : ''}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>お問い合わせ</a>
    <button type="button" class="hdr-ham" id="hdr-ham" aria-label="メニューを開く" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="drw-ov" id="drw-ov"></div>
<nav class="drw" id="drw" aria-label="ドロワーメニュー" inert>
  <div class="drw-head">
    <a href="/" class="drw-logo">
      <img src="/images/icon.png" alt="" aria-hidden="true" style="height:36px;width:auto;"/>
      <span class="logo-jp" style="font-size:1.05rem;letter-spacing:.14em;">小澤鶏卵</span>
    </a>
    <button type="button" id="drw-cl" aria-label="メニューを閉じる">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
        <path d="M3 3l14 14M17 3L3 17" stroke="#4A3313" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <ul>
    {nav.map(item => (
      <li>
        <a href={item.href}>
          <span class="d-ja">{item.ja}</span>
        </a>
      </li>
    ))}
    {navMore.map(item => (
      <li>
        <a href={item.href}>
          <span class="d-ja">{item.ja}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="drw-ft">
    <a href="tel:076-466-3815" class="drw-tel">076-466-3815</a>
    <p class="drw-hours">月〜土 8:00〜17:00</p>
  </div>
</nav>

<style>
.hdr { position: fixed; top: 0; left: 0; right: 0; z-index: 200; height: 84px; display: flex; justify-content: space-between; align-items: center; background: var(--brand); box-shadow: 0 2px 10px rgba(90,64,26,.18); border-bottom: 1px solid rgba(90,64,26,.12); }
.hdr-brand { flex-shrink: 0; display: flex; align-items: center; gap: .7rem; text-decoration: none; padding: 0 2rem 0 1.5rem; }
.hdr-blob { display: flex; align-items: center; justify-content: center; width: 70px; height: 60px; background: #fff; border-radius: 58% 42% 55% 45% / 52% 60% 40% 48%; box-shadow: 0 2px 8px rgba(150,105,0,.18); flex-shrink: 0; }
.hdr-logo-icon { height: 48px; width: auto; display: block; object-fit: contain; }
.logo-jp { display: block; font-family: 'Zen Kaku Gothic New', sans-serif; font-size: 1.15rem; font-weight: 500; color: #5A401A; letter-spacing: .2em; line-height: 1.2; }
.logo-en { display: block; font-family: Manrope, sans-serif; font-size: .75rem; letter-spacing: .2em; color: #5A401A; margin-top: 4px; white-space: nowrap; }
.hdr-right { display: flex; align-items: center; gap: 1.2rem; padding: 0 1.5rem 0 2.2rem; }
.hdr-nav ul { display: flex; align-items: center; list-style: none; margin: 0; padding: .5rem .9rem; gap: .35rem; background: #fff; border-radius: 999px; box-shadow: 0 2px 10px rgba(90,64,26,.15); }
.hdr-nav a { display: block; font-size: 15px; font-weight: 700; letter-spacing: .08em; padding: .3rem .8rem !important; color: #4A3313; text-decoration: none; padding: .3rem 0; border-bottom: 1.5px solid transparent; transition: border-color .2s, color .2s; white-space: nowrap; }
.hdr-nav a { border-bottom: 0 !important; border-radius: 999px; padding: .55rem 1rem !important; }
.hdr-nav a:hover { background: #FFF3C2; }
.hdr-nav a { font-size: 16px !important; letter-spacing: .04em !important; }
.hdr-nav a.gift { display: inline-flex; align-items: center; gap: .4rem; background: #5A401A; color: #fff; margin: 0 .25rem; box-shadow: 0 2px 6px rgba(90,64,26,.35); }
.hdr-nav a.gift:hover { background: #46320F; }
.hdr-nav a.gift.act { background: #5A401A; outline: 3px solid var(--brand); outline-offset: -3px; }
.hdr-nav a.act { background: radial-gradient(ellipse at 50% 40%, #FFD93B 0%, #FCC800 70%, #F0B800 100%); color: var(--on-brand); border-radius: 50% / 55%; padding: .35rem 1rem !important; box-shadow: 0 1px 3px rgba(150,105,0,.35); }
.hdr-biz { display: inline-flex; align-items: center; gap: .5rem; height: 46px; padding: 0 1.2rem; border-radius: 999px; background: #5A401A; color: #fff; text-decoration: none; font-weight: 700; font-size: 16px; letter-spacing: .06em; white-space: nowrap; box-shadow: 0 2px 6px rgba(90,64,26,.35); transition: background .2s; }
.hdr-biz:hover, .hdr-biz.act { background: #46320F; }
@media (min-width: 1261px) { .hdr-right { align-items: stretch; } .hdr-biz { height: auto; padding: 0 1.6rem; } }
.hdr-tel { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; height: 46px; min-width: 46px; padding: 0 .9rem; border-radius: 999px; background: #fff; color: #4A3313; text-decoration: none; font-family: Manrope, sans-serif; font-weight: 700; letter-spacing: .04em; font-size: 14px; white-space: nowrap; transition: background .2s; }
.hdr-tel:hover { background: #F6F6F6; }
.hdr-tel-num { display: none; }
@media (min-width: 1500px) { .hdr-tel-num { display: inline; } }
@media (max-width: 1499px) { .hdr-tel { padding: 0; width: 46px; } }
@media (min-width: 1261px) { .hdr-ham { display: none !important; } }
.hdr-ham { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; width: 54px; height: 54px; border-radius: 50%; border: 1px solid #5A401A; background: transparent; cursor: pointer; padding: 0; flex-shrink: 0; transition: background .2s; }
.hdr-ham:hover { background: rgba(0,0,0,.1); }
.hdr-ham span { display: block; width: 24px; height: 1px; background: #4A3313; transition: all .3s; }
.hdr-ham.open span:nth-child(1) { transform: translateY(3.5px) rotate(20deg); }
.hdr-ham.open span:nth-child(2) { transform: translateY(-3.5px) rotate(-20deg); }
/* ドロワー */
.drw-ov {
  display: none; position: fixed; inset: 0;
  background: rgba(30,30,28,0.45); z-index: 300; backdrop-filter: blur(3px);
}
.drw-ov.open { display: block; }
.drw {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(300px,88vw);
  background: white; z-index: 400;
  border-left: 0.5px solid rgba(44,44,42,0.08);
  transform: translateX(100%); visibility: hidden; transition: transform .38s cubic-bezier(.25,.46,.45,.94), visibility 0s .38s;
  display: flex; flex-direction: column; overflow-y: auto;
}
.drw.open { transform: translateX(0); visibility: visible; transition: transform .38s cubic-bezier(.25,.46,.45,.94), visibility 0s; }
.drw-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.25rem 1.5rem; border-bottom: 0.5px solid rgba(44,44,42,0.08);
}
.drw-logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
.drw-head button { background: none; border: none; cursor: pointer; padding: 6px; border-radius: 8px; transition: background .15s; }
.drw-head button:hover { background: #F4F2EB; }
.drw ul { list-style: none; margin: 0; padding: .5rem 0; flex: 1; }
.drw li { border-bottom: 0.5px solid rgba(44,44,42,0.05); }
.drw a { display: flex; align-items: center; justify-content: space-between; padding: .95rem 1.5rem; text-decoration: none; transition: background .15s; }
.drw a:hover { background: #FAFAF7; }
.d-en { font-family: Manrope, sans-serif; font-size: .75rem; font-weight: 700; letter-spacing: .18em; color: var(--amber); }
.d-ja { font-size: 1rem; font-weight: 500; color: #4A3313; }
.drw-ft {
  padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: .75rem;
  border-top: 0.5px solid rgba(44,44,42,0.08); background: #FAFAF7;
}
.drw-tel { font-family: Manrope, sans-serif; font-size: 1.4rem; font-weight: 700; color: #4A3313; text-decoration: none; letter-spacing: .04em; text-align: center; transition: color .18s; }
.drw-tel:hover { color: var(--amber); }
.drw-hours { font-size: .9rem; color: #7A6544; text-align: center; margin: 0; }


@media (max-width: 1260px) { .hdr-nav { display: none; } .hdr-right { padding: 0 .9rem 0 1.4rem; } }
@media (max-width: 640px) {  .hdr-logo-icon { height: 42px; } .logo-jp { font-size: 1.05rem; } .hdr-ham { width: 46px; height: 46px; } .hdr-biz { height: 38px; padding: 0 .8rem; font-size: 13px; } .hdr { height: 68px; } .hdr-brand { gap: .5rem; padding: 0 .8rem 0 .7rem; } .logo-en { letter-spacing: .1em; } .hdr-right { gap: .5rem; padding: 0 .7rem 0 1rem; } }
</style>

<script>
const hdr = document.getElementById('hdr')!;
const ham = document.getElementById('hdr-ham')!;
const drw = document.getElementById('drw')!;
const ov  = document.getElementById('drw-ov')!;
const cl  = document.getElementById('drw-cl')!;

window.addEventListener('scroll', () => {
  hdr.classList.toggle('scrolled', scrollY > 40);
}, { passive: true });

const open  = () => {
  drw.classList.add('open'); ov.classList.add('open');
  ham.classList.add('open'); ham.setAttribute('aria-expanded', 'true');
  drw.removeAttribute('inert');
  document.body.style.overflow = 'hidden';
};
const close = () => {
  drw.classList.remove('open'); ov.classList.remove('open');
  ham.classList.remove('open'); ham.setAttribute('aria-expanded', 'false');
  drw.setAttribute('inert', '');
  document.body.style.overflow = '';
};
ham.addEventListener('click', () => drw.classList.contains('open') ? close() : open());
cl.addEventListener('click', close);
ov.addEventListener('click', close);
drw.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
