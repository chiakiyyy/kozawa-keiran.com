---
const nav = [
  { en: 'ABOUT',    ja: '私たちについて', href: '/about' },
  { en: 'FEATURE',  ja: 'こだわり',       href: '/feature' },
  { en: 'LINE UP',  ja: '商品紹介',       href: '/products' },
  { en: 'GIFT',     ja: 'ギフト・購入',   href: '/gift' },
  { en: 'BUSINESS', ja: '法人のお客様',   href: '/business' },
  { en: 'WORKS',    ja: '実績',           href: '/works' },
  { en: 'CONTACT',  ja: 'お問い合わせ',   href: '/contact' },
];
// ドロワーのみに表示する項目
const navMore = [
  { en: 'DELIVERY', ja: '送料とお届け', href: '/delivery' },
];
const path = Astro.url.pathname;
---

<header class="hdr" id="hdr">
  <a href="/" class="hdr-brand" aria-label="小澤鶏卵 トップへ">
    <img src="/images/icon.png" alt="" aria-hidden="true" class="hdr-logo-icon"/>
    <span>
      <span class="logo-jp">小澤鶏卵</span>
      <span class="logo-en">KOZAWA KEIRAN</span>
    </span>
  </a>
  <div class="hdr-right">
    <nav class="hdr-nav" aria-label="メインナビゲーション">
      <ul>
        {nav.map(item => (
          <li><a href={item.href} class={path.startsWith(item.href) ? 'act' : ''}>{item.ja}</a></li>
        ))}
      </ul>
    </nav>
    <a href="tel:076-466-3815" class="hdr-tel" aria-label="電話をかける 076-466-3815">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3.5C3 3.5 4.5 2 6 2c.5 0 1 .3 1.3.8l1.4 2.4c.3.5.2 1.1-.2 1.5L7.2 8c.8 1.5 2 2.8 3.5 3.6l1.3-1.3c.4-.4 1-.5 1.5-.2l2.4 1.4c.5.3.8.8.8 1.3 0 1.5-1.5 3-1.5 3C6 18 2 10 3 3.5z"/></svg>
      <span class="hdr-tel-num">076-466-3815</span>
    </a>
    <button type="button" class="hdr-ham" id="hdr-ham" aria-label="メニューを開く" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="drw-ov" id="drw-ov"></div>
<nav class="drw" id="drw" aria-label="ドロワーメニュー" inert>
  <div class="drw-head">
    <a href="/" class="drw-logo">
      <img src="/images/icon.png" alt="" aria-hidden="true" style="height:36px;width:auto;"/>
      <span class="logo-jp" style="font-size:.95rem;letter-spacing:.14em;">小澤鶏卵</span>
    </a>
    <button type="button" id="drw-cl" aria-label="メニューを閉じる">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
        <path d="M3 3l14 14M17 3L3 17" stroke="#1E1E1C" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <ul>
    {nav.map(item => (
      <li>
        <a href={item.href}>
          <span class="d-en">{item.en}</span>
          <span class="d-ja">{item.ja}</span>
        </a>
      </li>
    ))}
    {navMore.map(item => (
      <li>
        <a href={item.href}>
          <span class="d-en">{item.en}</span>
          <span class="d-ja">{item.ja}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="drw-ft">
    <a href="tel:076-466-3815" class="drw-tel">076-466-3815</a>
    <p class="drw-hours">月〜土 8:00〜17:00</p>
  </div>
</nav>

<style>
.hdr { position: fixed; top: 0; left: 0; right: 0; z-index: 200; display: flex; justify-content: space-between; align-items: flex-start; pointer-events: none; }
.hdr > * { pointer-events: auto; }
.hdr-brand { display: flex; align-items: center; gap: .7rem; text-decoration: none; background: var(--panel, #F6F1E6); padding: .9rem 2rem .9rem 1.5rem; border-radius: 0 0 var(--notch-r, 28px) 0; }
.hdr-logo-icon { height: 40px; width: auto; display: block; object-fit: contain; }
.logo-jp { display: block; font-family: 'Zen Kaku Gothic New', sans-serif; font-size: 1.15rem; font-weight: 500; color: #2C2A24; letter-spacing: .2em; line-height: 1.2; }
.logo-en { display: block; font-family: Manrope, sans-serif; font-size: .56rem; letter-spacing: .3em; color: #8d8a82; margin-top: 4px; }
.hdr-right { display: flex; align-items: center; gap: 1.2rem; background: var(--panel, #F6F1E6); padding: 1rem 1.5rem 1rem 2.2rem; border-radius: 0 0 0 var(--notch-r, 28px); }
.hdr-nav ul { display: flex; list-style: none; margin: 0; padding: 0; gap: .4rem; }
.hdr-nav a { display: block; font-size: 14px; font-weight: 700; letter-spacing: .08em; padding: .3rem .8rem !important; color: #1E1E1C; text-decoration: none; padding: .3rem 0; border-bottom: 1.5px solid transparent; transition: border-color .2s, color .2s; white-space: nowrap; }
.hdr-nav a:hover, .hdr-nav a.act { color: var(--amber, #945810); border-color: var(--amber-lt, #EF9F27); }
.hdr-tel { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; height: 46px; min-width: 46px; padding: 0 .9rem; border-radius: 999px; background: var(--amber); color: #fff; text-decoration: none; font-family: Manrope, sans-serif; font-weight: 700; letter-spacing: .04em; font-size: 14px; white-space: nowrap; transition: background .2s; }
.hdr-tel:hover { background: #7A4A0D; }
.hdr-tel-num { display: none; }
@media (min-width: 1500px) { .hdr-tel-num { display: inline; } }
@media (max-width: 1499px) { .hdr-tel { padding: 0; width: 46px; } }
.hdr-ham { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; width: 54px; height: 54px; border-radius: 50%; border: 1px solid #5a564c; background: transparent; cursor: pointer; padding: 0; flex-shrink: 0; transition: background .2s; }
.hdr-ham:hover { background: rgba(186,117,23,.1); }
.hdr-ham span { display: block; width: 24px; height: 1px; background: #1E1E1C; transition: all .3s; }
.hdr-ham.open span:nth-child(1) { transform: translateY(3.5px) rotate(20deg); }
.hdr-ham.open span:nth-child(2) { transform: translateY(-3.5px) rotate(-20deg); }
/* ドロワー */
.drw-ov {
  display: none; position: fixed; inset: 0;
  background: rgba(30,30,28,0.45); z-index: 300; backdrop-filter: blur(3px);
}
.drw-ov.open { display: block; }
.drw {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(300px,88vw);
  background: white; z-index: 400;
  border-left: 0.5px solid rgba(44,44,42,0.08);
  transform: translateX(100%); visibility: hidden; transition: transform .38s cubic-bezier(.25,.46,.45,.94), visibility 0s .38s;
  display: flex; flex-direction: column; overflow-y: auto;
}
.drw.open { transform: translateX(0); visibility: visible; transition: transform .38s cubic-bezier(.25,.46,.45,.94), visibility 0s; }
.drw-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.25rem 1.5rem; border-bottom: 0.5px solid rgba(44,44,42,0.08);
}
.drw-logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
.drw-head button { background: none; border: none; cursor: pointer; padding: 6px; border-radius: 8px; transition: background .15s; }
.drw-head button:hover { background: #F4F2EB; }
.drw ul { list-style: none; margin: 0; padding: .5rem 0; flex: 1; }
.drw li { border-bottom: 0.5px solid rgba(44,44,42,0.05); }
.drw a { display: flex; align-items: center; justify-content: space-between; padding: .95rem 1.5rem; text-decoration: none; transition: background .15s; }
.drw a:hover { background: #FAFAF7; }
.d-en { font-family: Manrope, sans-serif; font-size: .6rem; font-weight: 700; letter-spacing: .18em; color: var(--amber); }
.d-ja { font-size: .88rem; font-weight: 500; color: #1E1E1C; }
.drw-ft {
  padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: .75rem;
  border-top: 0.5px solid rgba(44,44,42,0.08); background: #FAFAF7;
}
.drw-tel { font-family: Manrope, sans-serif; font-size: 1.4rem; font-weight: 700; color: #1E1E1C; text-decoration: none; letter-spacing: .04em; text-align: center; transition: color .18s; }
.drw-tel:hover { color: var(--amber); }
.drw-hours { font-size: .76rem; color: #9B9994; text-align: center; margin: 0; }


@media (max-width: 1260px) { .hdr-nav { display: none; } .hdr-right { padding: .8rem .9rem .9rem 1.4rem; } }
@media (max-width: 640px) { .hdr-brand { padding: .7rem 1.2rem .7rem .9rem; } .hdr-logo-icon { height: 32px; } .logo-jp { font-size: .95rem; } .hdr-ham { width: 46px; height: 46px; } }
</style>

<script>
const hdr = document.getElementById('hdr')!;
const ham = document.getElementById('hdr-ham')!;
const drw = document.getElementById('drw')!;
const ov  = document.getElementById('drw-ov')!;
const cl  = document.getElementById('drw-cl')!;

window.addEventListener('scroll', () => {
  hdr.classList.toggle('scrolled', scrollY > 40);
}, { passive: true });

const open  = () => {
  drw.classList.add('open'); ov.classList.add('open');
  ham.classList.add('open'); ham.setAttribute('aria-expanded', 'true');
  drw.removeAttribute('inert');
  document.body.style.overflow = 'hidden';
};
const close = () => {
  drw.classList.remove('open'); ov.classList.remove('open');
  ham.classList.remove('open'); ham.setAttribute('aria-expanded', 'false');
  drw.setAttribute('inert', '');
  document.body.style.overflow = '';
};
ham.addEventListener('click', () => drw.classList.contains('open') ? close() : open());
cl.addEventListener('click', close);
ov.addEventListener('click', close);
drw.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
