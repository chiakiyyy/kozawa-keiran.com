---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';

// 内容は出品ページ（リベシティ市場）の条件に基づく。当サイト独自の運用と異なる場合は修正すること。
const rows = [
  { dt: '配送方法', dd: 'チルドゆうパック（全国対応）' },
  { dt: '送料', dd: '商品により異なります。「送料込み」の商品は、本州・四国・九州への送料はかかりません。お試し10個入りは送料1,200円です（同商品2点まで追加送料なし。3点以上は別途ご案内）。' },
  { dt: '地域による加算', dd: '北海道：＋500円／沖縄：＋1,000円' },
  { dt: '発送日', dd: '月・水・金に発送します。お支払いの確認後、当日〜3日が目安です。' },
  { dt: 'お届け', dd: '発送から1〜2日が目安です（地域により前後します）。' },
  { dt: 'お支払い', dd: 'クレジットカード（Square）／楽天ペイ 残高送金' },
  { dt: 'のし・内箱', dd: '「卵かけご飯セット」は、のし・内箱に対応しています。その他の商品はギフト対応が可能です。ご希望はご注文時にお知らせください。' },
  { dt: '賞味の目安', dd: '生食の場合は、採卵日より14日以内にお召し上がりください。' },
];
const faqs = [
  { q: '送料はいくらですか？', a: '「送料込み」と表示の商品は、本州・四国・九州への送料はかかりません。北海道は＋500円、沖縄は＋1,000円です。お試し10個入りは送料1,200円（2点まで）です。' },
  { q: 'どんな方法で届きますか？', a: 'チルドゆうパックでお届けします。鮮度を保ったまま、ご自宅やご指定の場所へお届けします。' },
  { q: 'いつ届きますか？', a: 'お支払いの確認後、月・水・金に発送します。お届けは発送から1〜2日が目安です。' },
  { q: 'お支払い方法を教えてください。', a: 'クレジットカード（Square）と、楽天ペイの残高送金に対応しています。ご注文の送信後に、手順をご案内します。' },
  { q: 'のしやメッセージカードは付けられますか？', a: '注文フォームの「のし」「メッセージカード・備考」欄にご記入ください。商品により対応が異なりますので、詳しくはお問い合わせください。' },
  { q: 'たまごが割れていた場合は？', a: 'お届け時に割れがあった場合は、写真をLINEにお送りください。対応いたします。' },
  { q: '生で食べても大丈夫ですか？', a: '生食の場合は、採卵日より14日以内にお召し上がりください。卵の保管・取り扱いには十分ご注意ください。' },
];
---
<Layout title="送料とお届けについて｜小澤鶏卵" description="小澤鶏卵のたまご・ギフトの送料、配送方法、発送日、お届けの目安、お支払い方法、よくあるご質問をご案内します。">
  <Header/>
  <main>
    <PageHero en="Delivery" ja="送料とお届けについて" img="/images/shop/point4.jpg" lead="鮮度を保ったまま、チルドでお届けします。送料・発送日・お支払い方法をご案内します。"/>

    <section class="sec">
      <div class="container nrw">
        <div class="ttl"><h2 class="ttl-en">Shipping</h2><p class="ttl-ja">配送のご案内</p></div>
        <dl class="dl">
          {rows.map(r => (<><dt>{r.dt}</dt><dd>{r.dd}</dd></>))}
        </dl>
        <p class="note">※商品ごとの価格・送料は、ギフト・商品ページでご確認ください。内容は変更されることがあります。</p>
        <div style="text-align:center;margin-top:2.5rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
          <a href="/gift" class="btn-circle">ギフト・商品を見る</a>
          <a href="/gift/order" class="btn btn-primary">注文フォームへ</a>
        </div>
      </div>
    </section>

    <section class="sec sec--pale">
      <div class="container nrw">
        <div class="ttl"><h2 class="ttl-en">FAQ</h2><p class="ttl-ja">よくあるご質問</p></div>
        <div class="faq">
          {faqs.map(f => (
            <details>
              <summary><span class="q">Q</span>{f.q}</summary>
              <p><span class="q a">A</span>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <ContactSection/>
  </main>
  <Footer/>
</Layout>

<style>
.nrw { max-width: 820px; }
.dl { display: grid; grid-template-columns: 9rem 1fr; margin: 0; border-top: 1px solid var(--border); }
.dl dt, .dl dd { padding: 1.2rem .5rem; border-bottom: 1px solid var(--border); margin: 0; }
.dl dt { font-weight: 700; color: var(--amber); font-size: .92rem; }
.dl dd { font-size: .95rem; line-height: 2; }
.note { font-size: .8rem; color: var(--muted); margin-top: 1.5rem; }
.faq { display: grid; gap: .8rem; }
.faq details { background: #fff; border: .5px solid var(--border); border-radius: 14px; padding: 0 1.4rem; }
.faq summary { cursor: pointer; padding: 1.2rem 0; font-weight: 700; font-size: .95rem; list-style: none; display: flex; gap: .9rem; align-items: baseline; }
.faq summary::-webkit-details-marker { display: none; }
.faq p { margin: 0; padding: 0 0 1.3rem; font-size: .92rem; line-height: 2; color: var(--muted); display: flex; gap: .9rem; align-items: baseline; }
.q { font-family: Manrope, sans-serif; font-weight: 700; color: var(--amber-lt); }
.q.a { color: var(--muted); }
@media (max-width: 640px) { .dl { grid-template-columns: 1fr; } .dl dt { border-bottom: 0; padding-bottom: 0; } }
</style>
