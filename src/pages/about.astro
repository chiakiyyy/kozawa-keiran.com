---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import FeatureSections from '../components/FeatureSections.astro';

const history = [
  { year: '1945年', event: '小澤鶏卵 創業', body: '鶏卵の商いを始める' },
  { year: '80年以上', event: '鶏卵ひと筋に歩む', body: '富山の食卓と飲食店へ' },
  { year: '現在', event: '富山の事業者様へお届け', body: '飲食店・菓子店・スーパー・施設など' },
  { year: 'これから', event: 'ギフトのオンライン注文を開始', body: 'より多くの食卓へ' },
];

const company = [
  ['会社名', '小澤鶏卵（KOZAWA KEIRAN）'],
  ['代表者', '小澤 龍生'],
  ['創業', '1945年（昭和20年）'],
  ['所在地', '〒939-2716 富山県富山市婦中町下轡田25-1'],
  ['電話番号', '076-466-3815'],
  ['メール', 'info@kozawa-keiran.com'],
  ['営業時間', '月〜土 8:00〜17:00（日曜・祝日は休業）'],
  ['事業内容', '鶏卵の販売・卸売'],
  ['取引先', '飲食店・菓子店・スーパー・給食施設 など'],
  ['配送エリア', '富山市内（当日配達）／富山県内（要相談）'],
];
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('富山県富山市婦中町下轡田25-1');
---
<Layout title="私たちについて｜1945年創業・富山の鶏卵専門店｜小澤鶏卵" description="1945年創業、富山市婦中町の鶏卵専門店・小澤鶏卵の紹介ページです。5つのこだわり、採卵から出荷までの流れ、代表あいさつ、沿革、会社概要をご紹介します。">
  <Header/>
  <main>
    <PageHero en="About us" ja="私たちについて" img="/images/shop/point1.jpg" lead="小澤鶏卵は、富山市婦中町の鶏卵専門店です。飲食店や給食施設の厨房へ、ご家庭の食卓へ、毎日たまごをお届けしています。"/>



    <FeatureSections/>

    <!-- 代表あいさつ -->
    <section class="greet" id="message">
      <div class="container">
        <div class="ttl"><h2 class="ttl-en">代表あいさつ</h2></div>
        <div class="greet-body serif">
          <p>小澤鶏卵のホームページをご覧いただき、ありがとうございます。 代表の小澤龍生です。</p>
          <p>当店は1945年（昭和20年）に創業し、80年以上にわたり、富山の地でたまごをお届けしてまいりました。これまで続けてこられたのは、ひとえにお客様のお支えがあったからこそと、心より感謝しております。</p>
          <p>私たちが何より大切にしているのは、「お客様第一」という思いです。 毎日お使いいただくものだからこそ、新鮮さと品質には妥協せず、ご注文やご要望には、できる限り柔軟に、そして誠実にお応えしてまいります。</p>
          <p>たまごひとつにも、それを召し上がる方の笑顔があります。 その顔を思い浮かべながら、一つひとつ丁寧にお届けすることが、私たちの仕事です。</p>
          <p>飲食店様の厨房へ、ご家庭の食卓へ、そして大切な方への贈り物として。 お困りごとやご要望がありましたら、どうぞお気軽にお声がけください。</p>
          <p>これからも、お客様に信頼され、選んでいただける存在であり続けられるよう、私たち一同、心を込めてまいります。</p>
          <p class="greet-sign"><span>小澤鶏卵　代表</span><b>小澤 龍生</b></p>
        </div>
      </div>
    </section>

    <!-- 沿革 -->
    <section class="ab-history">
      <div class="container">
        <div class="ab-head ab-head--left">
          <h2>沿革</h2>
        </div>
        <div class="ab-timeline">
          <span class="ab-timeline-line"></span>
          {history.map(h => (
            <div class="ab-tl-item">
              <span class="ab-tl-dot"></span>
              <span class="ab-tl-year">{h.year}</span>
              <p class="ab-tl-event">{h.event}<br/>{h.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 会社概要 -->
    <section class="ab-company" id="company">
      <div class="container ab-company-grid">
        <div class="ab-company-text">
          <h2>会社概要</h2>
          <table class="ab-table">
            <tbody>
              {company.map(([th, td]) => (
                <tr><th scope="row">{th}</th><td>{td}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class:list={["ab-company-img", { "img-fallback": false }]}>
          <img src="/images/feature/feature-egg.jpg" width="1000" height="667" alt="パック詰めされたたまご" loading="lazy" onerror="this.closest('.ab-company-img').classList.add('img-fallback')"/>
        </div>
      </div>
        <p style="text-align:center;margin:2rem 0 0"><a href={mapUrl} target="_blank" rel="noopener" class="btn-circle">地図で見る（Googleマップ）</a></p>
    </section>

    <!-- CONTACT -->
    <ContactSection/>
  </main>
  <Footer/>
</Layout>
<style>
.greet { background: var(--panel); padding: 96px 0; }
.greet-body { max-width: 720px; margin: 0 auto; }
.greet-body { max-width: 760px; }
.greet-body p { font-size: 1rem; line-height: 2.4; letter-spacing: .08em; margin: 0 0 1.6rem; color: #643E2F; }
.greet-sign { text-align: right; margin-top: 2.5rem !important; display: grid; gap: .2rem; }
.greet-sign span { font-size: 1rem; color: var(--muted); }
.greet-sign b { font-size: 1.3rem; letter-spacing: .25em; font-weight: 500; }
.container { max-width:1200px; margin:0 auto; padding:0 2rem; }

/* パンくず */
.breadcrumb { margin-top:84px; padding:.9rem 0; background:#FAFAF7; border-bottom:1px solid rgba(0,0,0,.08); }
.breadcrumb .container { font-size:.92rem; color:#6E5144; }
.breadcrumb a { color:#6E5144; text-decoration:none; }
.breadcrumb a:hover { color:#643E2F; }
.breadcrumb span { margin:0 .4rem; }

/* ヒーロー */
.ab-hero { padding:4.5rem 0 3.5rem; background: var(--bg); }
.ab-hero-in { display:grid; grid-template-columns:1fr 1.1fr; gap:3rem; align-items:center; }
.ab-en { font-family:Manrope,sans-serif; font-size:.85rem; letter-spacing:.25em; color:#643E2F; text-transform:uppercase; display:block; margin-bottom:.6rem; }
.ab-hero-text h1 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:clamp(1.9rem,4vw,2.7rem); font-weight:700; color:#643E2F; margin-bottom:1.25rem; }
.ab-hero-text p { font-size:1rem; color:#6E5144; line-height:1.9; }
.ab-hero-img { border-radius:20px; overflow:hidden; aspect-ratio:16/10; }
.ab-hero-img img { width:100%; height:100%; object-fit:cover; display:block; }
.ab-hero-img.img-fallback { background:linear-gradient(135deg,#FCE9B8,#FFE200); display:flex; align-items:center; justify-content:center; }
.ab-hero-img.img-fallback img { display:none; }

/* 見出し共通 */
.ab-head { text-align:center; margin-bottom:3rem; }
.ab-head--left { text-align:left; margin-bottom:2.5rem; }
.ab-head h2 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:clamp(1.3rem,2.6vw,1.7rem); font-weight:700; color:#643E2F; }
.ab-head-line { display:block; width:2.5rem; height:2px; background:var(--brand); margin:1.1rem auto 0; }

/* 想い */
.ab-thoughts { padding:5rem 0; background: var(--bg); }
.ab-thoughts-grid { display:grid; grid-template-columns:1fr auto 1fr auto 1fr; gap:2rem; align-items:start; }
.ab-thought { text-align:center; padding:0 .5rem; }
.ab-thought-icon { width:76px; height:76px; border-radius:50%; background:var(--butter); display:flex; align-items:center; justify-content:center; margin:0 auto 1.1rem; }
.ab-thought h3 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1rem; font-weight:700; color:#643E2F; margin-bottom:.65rem; }
.ab-thought p { font-size:.97rem; color:#6E5144; line-height:1.8; margin:0; }
.ab-thought-sep { width:1px; height:120px; align-self:center; background:rgba(0,0,0,.18); }

/* 代表あいさつ */
.ab-greeting { padding:0 0 5rem; background: var(--bg); }
.ab-greeting-card { background:#FAFAF7; border-radius:20px; padding:2.5rem; display:grid; grid-template-columns:280px 1fr; gap:2.75rem; align-items:center; }
.ab-greeting-img { width:280px; height:340px; border-radius:14px; overflow:hidden; flex-shrink:0; }
.ab-greeting-img img { width:100%; height:100%; object-fit:cover; display:block; }
.ab-greeting-img.img-fallback { background:linear-gradient(135deg,#FCE9B8,#FFE200); display:flex; align-items:center; justify-content:center; }
.ab-greeting-img.img-fallback img { display:none; }
.ab-greeting-text h2 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.35rem; font-weight:700; color:#643E2F; margin:.3rem 0 1.25rem; }
.ab-greeting-text p { font-size:1rem; color:#6E5144; line-height:1.95; margin-bottom:.85rem; }
.ab-sign { margin-top:1.25rem; display:flex; flex-direction:column; gap:.15rem; }
.ab-sign-role { font-size:.92rem; color:#6E5144; }
.ab-sign-name { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.05rem; font-weight:700; color:#643E2F; }

/* 沿革 */
.ab-history { padding:0 0 5rem; background: var(--bg); }
.ab-timeline { position:relative; display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; padding-top:1.5rem; }
.ab-timeline-line { position:absolute; left:6%; right:6%; top:9px; height:2px; background:repeating-linear-gradient(to right,#FFE200 0,#FFE200 6px,transparent 6px,transparent 12px); }
.ab-tl-item { text-align:center; position:relative; }
.ab-tl-dot { display:block; width:18px; height:18px; border-radius:50%; border:3px solid #FFE200; background:#fff; margin:0 auto .85rem; position:relative; z-index:2; }
.ab-tl-year { display:block; font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.03rem; font-weight:700; color:#643E2F; margin-bottom:.5rem; }
.ab-tl-event { font-size:.92rem; color:#6E5144; line-height:1.7; margin:0; }

/* 会社概要 */
.ab-company { padding:0 0 5rem; background: var(--bg); }
.ab-company-grid { display:grid; grid-template-columns:1.2fr 1fr; gap:3.5rem; align-items:start; }
.ab-company-text h2 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.4rem; font-weight:700; color:#643E2F; margin:.3rem 0 1.5rem; }
.ab-table { width:100%; border-collapse:collapse; }
.ab-table tr { border-bottom:1px solid rgba(0,0,0,.12); }
.ab-table th { width:8rem; text-align:left; padding:.85rem 1rem .85rem 0; font-size:.97rem; font-weight:700; color:#643E2F; vertical-align:top; white-space:nowrap; }
.ab-table td { padding:.85rem 0; font-size:1rem; color:#6E5144; line-height:1.7; vertical-align:top; }
.ab-company-img { border-radius:16px; overflow:hidden; aspect-ratio:4/3; }
.ab-company-img img { width:100%; height:100%; object-fit:cover; display:block; }
.ab-company-img.img-fallback { background:linear-gradient(135deg,#FFE200,#EA5514); display:flex; align-items:center; justify-content:center; }
.ab-company-img.img-fallback img { display:none; }

@media (max-width:900px) {
  .ab-thoughts-grid { grid-template-columns:1fr; gap:2rem; }
  .ab-thought-sep { display:none; }
  .ab-greeting-card { grid-template-columns:1fr; text-align:center; }
  .ab-greeting-img { width:200px; height:240px; margin:0 auto; }
  .ab-timeline { grid-template-columns:repeat(2,1fr); gap:2rem; }
  .ab-timeline-line { display:none; }
  .ab-company-grid { grid-template-columns:1fr; }
}
@media (max-width:780px) {
  .ab-hero-in { grid-template-columns:1fr; }
  .ab-hero-img { order:-1; }
}
</style>
