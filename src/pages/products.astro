---
import { dim } from '../data/imgsize';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { productGroups, sizes } from '../data/products';
import ContactSection from '../components/ContactSection.astro';

---
<Layout title="業務用卵の商品紹介｜10kg箱・パック卵・ブランド卵｜富山の小澤鶏卵" description="富山の小澤鶏卵の商品紹介。業務用の10kg箱（LL〜S）、パック卵、ブランド卵、うずら卵、温泉卵まで。飲食店・製菓・給食施設向けの業務用卵をご用意しています。">
  <Header/>
  <main>
    <PageHero en="Products" ja="業務用たまごの商品紹介" lead="飲食店・製菓・給食施設などで使う、業務用のたまごをご紹介します。ギフト・ご自宅用のたまごは、オンラインショップでご覧いただけます。"/>

    <!-- 取り扱い商品 -->
    <section class="pd-lineup">
      <div class="container">
        <div class="ttl"><h2 class="ttl-en">取り扱い商品</h2></div>
        <div class="pd-panel" id="tab-biz">
        <div class="pg-list">
          {productGroups.map(g => (
            <article class="pg" id={g.id}>
              <div class="pg-img"><img src={g.img} {...dim(g.img)} alt={g.name} loading="lazy"/></div>
              <div class="pg-body">
                <h3>{g.name}</h3>
                <p class="pg-lead">{g.lead}</p>
                <ul class="pg-items">
                  {g.items.map(i => <li>{i.name}{i.spec && <small>{i.spec}</small>}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
        <p class="pg-note">10kg箱のサイズ：{sizes.join('・')}　※価格・在庫・規格は、お問い合わせください。</p>
        <p class="pg-note">ギフト・ご自宅用のたまごは、<a href="/gift/">オンラインショップ</a>でご注文いただけます。</p>
        </div>
      </div>
    </section>


    <!-- 業務用のご相談 -->
    <section class="pd-biz">
      <div class="container pd-biz-grid">
        <div class="pd-biz-text">
          <h3>業務用のお取引について</h3>
          <p>飲食店・給食施設・食品加工業者様へ、10kg箱やパック卵を定期的にお届けしています。配達エリア、注文の締め切り、お支払い方法は、法人のお客様のページでご案内しています。</p>
          <ul class="pd-biz-checks">
            <li>✓ 定期納品・数量のご相談</li>
            <li>✓ 富山市内は自社便で配達</li>
            <li>✓ 1ケース（約10kg）から</li>
            <li>✓ 請求書払い（掛け売り）</li>
          </ul>
          <p style="margin-top:1.5rem"><a href="/business/" class="btn btn-primary">法人のお客様へ →</a></p>
        </div>
        <div class:list={["pd-biz-img", { "img-fallback": false }]}>
          <img src="/images/feature/feature-factory.jpg" width="375" height="249" alt="検卵ライン" loading="lazy" onerror="this.closest('.pd-biz-img').classList.add('img-fallback')"/>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <ContactSection title="商品・価格のお問い合わせ"/>
  </main>
  <Footer/>
</Layout>
<style>
.pd-tabs { display: flex; max-width: 640px; margin: 0 auto 2.5rem; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 2px 10px rgba(90,64,26,.1); }
.pd-tab { flex: 1; padding: 1rem; border: 0; background: transparent; font-size: 1.02rem; font-weight: 700; color: var(--muted); cursor: pointer; font-family: inherit; letter-spacing: .06em; }
.pd-tab.on { background: var(--cta); color: #fff; }
.pd-panel[hidden] { display: none; }
.pg-price { margin: 0 0 1.2rem; font-size: 1.3rem; font-weight: 700; color: #643E2F; } .pg-price small { font-size: .88rem; font-weight: 400; color: var(--muted); margin-left: .4rem; }
.pg-list { display: grid; gap: 2rem; }
.pg { display: grid; grid-template-columns: 340px 1fr; gap: 2.5rem; align-items: center; background: #fff; border: .5px solid var(--border); border-radius: 20px; padding: 1.5rem; }
.pg-img { border-radius: 14px; overflow: hidden; aspect-ratio: 4/3; background: var(--panel); }
.pg-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pg-body h3 { margin: 0 0 .5rem; font-size: 1.25rem; color: #643E2F; letter-spacing: .08em; }
.pg-lead { margin: 0 0 1.2rem; font-size: 1.03rem; line-height: 2; color: var(--muted); }
.pg-items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
.pg-items li { background: var(--panel); border-radius: 999px; padding: .4rem 1rem; font-size: 1rem; font-weight: 700; }
.pg-items small { margin-left: .5rem; font-weight: 400; color: var(--muted); font-size: .88rem; }
.pg-note { text-align: center; font-size: .97rem; color: var(--muted); margin-top: 2rem; line-height: 2; }
.pg-note a { color: #643E2F; text-decoration: underline; }
@media (max-width: 860px) { .pg { grid-template-columns: 1fr; } }
.container { max-width:1200px; margin:0 auto; padding:0 2rem; }

/* パンくず */
.breadcrumb { margin-top:84px; padding:.9rem 0; background:#FAFAF7; border-bottom:1px solid rgba(0,0,0,.08); }
.breadcrumb .container { font-size:.92rem; color:#6E5144; }
.breadcrumb a { color:#6E5144; text-decoration:none; }
.breadcrumb a:hover { color:#643E2F; }
.breadcrumb span { margin:0 .4rem; }

/* ヒーロー */
.pd-hero { padding:4.5rem 0 3.5rem; background: var(--bg); }
.pd-hero-in { display:grid; grid-template-columns:1fr 1.1fr; gap:3rem; align-items:center; }
.pd-en { font-family:Manrope,sans-serif; font-size:.85rem; letter-spacing:.25em; color:#643E2F; text-transform:uppercase; display:block; margin-bottom:.6rem; }
.pd-hero-text h1 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:clamp(1.9rem,4vw,2.7rem); font-weight:700; color:#643E2F; margin-bottom:1.25rem; }
.pd-hero-text p { font-size:1rem; color:#6E5144; line-height:1.9; }
.pd-hero-img { border-radius:20px; overflow:hidden; aspect-ratio:16/10; }
.pd-hero-img img { width:100%; height:100%; object-fit:cover; display:block; }
.pd-hero-img.img-fallback { background:linear-gradient(135deg,#FCE9B8,#FFE200); display:flex; align-items:center; justify-content:center; }
.pd-hero-img.img-fallback img { display:none; }

/* 取り扱い商品 */
.pd-lineup { padding:5rem 0; background: var(--bg); }
.pd-head { text-align:center; margin-bottom:3rem; }
.pd-head h2 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:clamp(1.3rem,2.6vw,1.7rem); font-weight:700; color:#643E2F; }
.pd-head-line { display:block; width:2.5rem; height:2px; background:var(--brand); margin:1.1rem auto 0; }

.pd-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
.pd-card { display:block; text-decoration:none; color:inherit; border-radius:14px; overflow:hidden; background:white; border:1px solid rgba(0,0,0,.12); box-shadow:0 4px 18px rgba(44,44,42,.05); transition:transform .2s, box-shadow .2s; }
.pd-card:hover { transform:translateY(-3px); box-shadow:0 12px 30px rgba(44,44,42,.1); }
.pd-card-img { position:relative; aspect-ratio:4/3; background:linear-gradient(135deg,#FCE9B8,#FFE200); display:flex; align-items:center; justify-content:center; }
.pd-card-badge { position:absolute; top:.75rem; left:.75rem; background:var(--brand); color:var(--on-brand); font-size: .75rem; font-weight:700; padding:.25rem .65rem; border-radius:999px; z-index:2; }
.pd-card-body { padding:1.25rem 1.1rem 1.5rem; }
.pd-card-body h3 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1rem; font-weight:700; color:#643E2F; margin-bottom:.5rem; }
.pd-card-note { font-size:.92rem; color:#6E5144; line-height:1.7; margin-bottom:1rem; min-height:3.4em; }
.pd-card-specs { display:grid; grid-template-columns:3.4rem 1fr; gap:.35rem .6rem; margin:0; border-top:1px solid rgba(0,0,0,.1); padding-top:.75rem; }
.pd-card-specs dt { font-size:.85rem; font-weight:700; color:#643E2F; }
.pd-card-specs dd { font-size:.85rem; color:#6E5144; margin:0; }

/* 梱包・配送 */
.pd-ship { padding:0 0 4rem; background: var(--bg); }
.pd-ship-card { border:1.5px solid rgba(0,0,0,.3); border-radius:16px; padding:2rem 2.25rem; display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap; }
.pd-ship-text h3 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.1rem; font-weight:700; color:#643E2F; margin-bottom:.5rem; }
.pd-ship-text p { font-size:.97rem; color:#6E5144; line-height:1.8; margin:0; }
.pd-ship-text { flex:1 1 320px; }
.pd-ship-steps { flex:1 1 360px; display:grid; grid-template-columns:1fr auto 1fr auto 1fr; align-items:start; gap:.5rem; max-width:520px; }
.pd-ship-step { display:flex; flex-direction:column; align-items:center; gap:.5rem; }
.pd-ship-icon { width:56px; height:56px; border-radius:50%; background:#FDF1DC; display:flex; align-items:center; justify-content:center; }
.pd-ship-step span { font-size:.85rem; color:#643E2F; font-weight:600; text-align:center; }
.pd-ship-arrow { color:#E3A91C; font-size:.9rem; line-height:56px; }

/* 業務用 */
.pd-biz { padding:0 0 5rem; background: var(--bg); }
.pd-biz-grid { display:grid; grid-template-columns:1.3fr 1fr; gap:3rem; align-items:center; background:#FDF6E9; border-radius:20px; padding:2.75rem; border:1px solid rgba(0,0,0,.15); }
.pd-biz-text h3 { font-family:'Zen Kaku Gothic New',sans-serif; font-size:1.2rem; font-weight:700; color:#643E2F; margin-bottom:.85rem; }
.pd-biz-text p { font-size:1rem; color:#6E5144; line-height:1.85; margin-bottom:1.25rem; }
.pd-biz-checks { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:.6rem 1rem; }
.pd-biz-checks li { font-size:.97rem; color:#643E2F; font-weight:600; }
.pd-biz-img { border-radius:14px; overflow:hidden; aspect-ratio:4/3; }
.pd-biz-img img { width:100%; height:100%; object-fit:cover; display:block; }
.pd-biz-img.img-fallback { background:linear-gradient(135deg,#FFE200,#EA5514); display:flex; align-items:center; justify-content:center; }
.pd-biz-img.img-fallback img { display:none; }

@media (max-width:1024px) {
  .pd-grid { grid-template-columns:repeat(2,1fr); }
  .pd-biz-grid { grid-template-columns:1fr; }
  .pd-biz-checks { grid-template-columns:1fr; }
}
@media (max-width:780px) {
  .pd-hero-in { grid-template-columns:1fr; }
  .pd-hero-img { order:-1; }
  .pd-ship-card { flex-direction:column; text-align:center; }
}
@media (max-width:560px) {
  .pd-grid { grid-template-columns:1fr; }
}
</style>
