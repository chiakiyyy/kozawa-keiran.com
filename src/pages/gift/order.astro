---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import { gifts, paymentMethods, rakutenPayGuide } from '../../data/gifts';

// お問い合わせフォームと同じ Google Apps Script に送信（gas/README.md 参照）
const squareUrls = Object.fromEntries(gifts.map(g => [g.id, g.squareUrl]));
const FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbwrMTrF_xGZw_xx5gorTiYiqP6bcTxgDRWJjVn4lInl_7lg55dEQc0Cxy_lF73HMFm6/exec';
---
<Layout title="ギフト注文フォーム｜小澤鶏卵" description="小澤鶏卵のギフトのご注文フォームです。商品・数量・お届け先を入力して送信してください。">
  <Header/>
  <main>
    <PageHero en="Order" ja="ギフト注文フォーム" img="/images/gift/tkg-wrapping.webp" lead="ご注文内容を入力してください。送信後、お支払い手順をご案内します。"/>

    <section class="sec">
      <div class="container od-wrap">
        <form class="od-form" id="order-form" data-endpoint={FORM_ENDPOINT} data-square={JSON.stringify(squareUrls)} data-rakuten={rakutenPayGuide} novalidate>
          <input type="hidden" name="form" value="order"/>
          <div class="hp" aria-hidden="true"><label>空欄のままにしてください<input type="text" name="website" tabindex="-1" autocomplete="off"/></label></div>

          <fieldset class="od-box">
            <legend>1. ご注文内容</legend>
            <div class="od-row">
              <div class="od-group od-grow">
                <label class="form-label" for="item">商品 <span class="req">*</span></label>
                <select class="form-select" id="item" name="item" required>
                  {gifts.map(g => <option value={g.id} data-price={g.price} data-ship={g.shippingFee}>{g.name}（{g.price.toLocaleString('ja-JP')}円・{g.shippingFee ? '送料別' : '送料込み'}）</option>)}
                </select>
              </div>
              <div class="od-group">
                <label class="form-label" for="qty">数量 <span class="req">*</span></label>
                <input class="form-input" type="number" id="qty" name="qty" min="1" max="50" value="1" required inputmode="numeric"/>
              </div>
            </div>
            <p class="od-total">合計の目安（送料込み）：<strong id="total">0</strong> 円</p>
            <p class="od-hint">※北海道は＋500円、沖縄は＋1,000円の送料を別途いただきます。お試し10個入りは、3点以上の送料を別途ご案内します。最終金額は、確認メールでご案内します。</p>
          </fieldset>

          <fieldset class="od-box">
            <legend>2. ご依頼主（ご注文者）</legend>
            <div class="od-row">
              <div class="od-group od-grow"><label class="form-label" for="s_name">お名前 <span class="req">*</span></label><input class="form-input" id="s_name" name="sender_name" required autocomplete="name"/></div>
              <div class="od-group od-grow"><label class="form-label" for="s_tel">電話番号 <span class="req">*</span></label><input class="form-input" type="tel" id="s_tel" name="sender_tel" required autocomplete="tel"/></div>
            </div>
            <div class="od-group"><label class="form-label" for="s_email">メールアドレス <span class="req">*</span></label><input class="form-input" type="email" id="s_email" name="sender_email" required autocomplete="email"/></div>
          </fieldset>

          <fieldset class="od-box">
            <legend>3. お届け先</legend>
            <label class="od-check"><input type="checkbox" id="same"/> ご依頼主と同じ（ご自宅などへお届け）</label>
            <div class="od-row">
              <div class="od-group od-grow"><label class="form-label" for="r_name">お名前 <span class="req">*</span></label><input class="form-input" id="r_name" name="recipient_name" required/></div>
              <div class="od-group od-grow"><label class="form-label" for="r_tel">電話番号 <span class="req">*</span></label><input class="form-input" type="tel" id="r_tel" name="recipient_tel" required/></div>
            </div>
            <div class="od-row">
              <div class="od-group"><label class="form-label" for="r_zip">郵便番号 <span class="req">*</span></label><input class="form-input" id="r_zip" name="recipient_zip" placeholder="939-2716" required autocomplete="postal-code"/></div>
              <div class="od-group od-grow"><label class="form-label" for="r_addr">ご住所 <span class="req">*</span></label><input class="form-input" id="r_addr" name="recipient_address" required autocomplete="street-address"/></div>
            </div>
            <div class="od-row">
              <div class="od-group od-grow">
                <label class="form-label" for="date">お届け希望日</label>
                <input class="form-input" type="date" id="date" name="desired_date"/>
              </div>
              <div class="od-group od-grow">
                <label class="form-label" for="noshi">のし</label>
                <select class="form-select" id="noshi" name="noshi">
                  <option value="なし">なし</option><option value="お中元">お中元</option><option value="お歳暮">お歳暮</option>
                  <option value="内祝い">内祝い</option><option value="御祝">御祝</option><option value="その他（備考に記入）">その他（備考に記入）</option>
                </select>
              </div>
            </div>
            <div class="od-group"><label class="form-label" for="memo">メッセージカード・備考</label><textarea class="form-textarea" id="memo" name="memo" rows="4" maxlength="500"></textarea></div>
          </fieldset>

          <fieldset class="od-box">
            <legend>4. お支払い方法</legend>
            <div class="od-pay">
              {paymentMethods.map((m, i) => (
                <label class="od-check"><input type="radio" name="payment" value={m.label} required checked={i === 0}/> {m.label}</label>
              ))}
            </div>
            <p class="od-hint">注文の送信後、選んだ方法でのお支払い手順を画面とメールでご案内します。</p>
          </fieldset>

          <label class="od-check"><input type="checkbox" name="privacy" required/> <span><a href="/about" class="od-link">プライバシーポリシー</a>に同意する <span class="req">*</span></span></label>

          <div class="od-submit">
            <button type="submit" class="btn btn-primary">注文を送信する</button>
            <p class="od-status" id="od-status" role="status" aria-live="polite"></p>
            <p class="od-hint">お支払い手順は、送信後にご案内します。このフォームにカード番号などは入力しないでください。<br/>お急ぎの場合はお電話（076-466-3815）またはLINEでご連絡ください。</p>
          </div>
        </form>

        <section class="od-next" id="od-next" hidden>
          <h2>ご注文を受け付けました</h2>
          <p id="od-next-lead"></p>
          <a id="od-next-card" class="btn btn-primary" target="_blank" rel="noopener" hidden>カードで支払う（Square）</a>
          <p id="od-next-rakuten" class="od-rakuten" hidden></p>
          <p class="od-hint">お支払い手順の詳細は、ご入力のメールアドレスにもお送りします。<br/>ご不明な点は、お電話（076-466-3815）またはLINEでご連絡ください。</p>
        </section>
      </div>
    </section>
  </main>
  <Footer/>
</Layout>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('od-status')!;
    const item = form.elements.namedItem('item') as HTMLSelectElement;
    const qty = form.elements.namedItem('qty') as HTMLInputElement;
    const total = document.getElementById('total')!;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const show = (msg: string, ok: boolean) => { status.textContent = msg; status.className = 'od-status ' + (ok ? 'is-ok' : 'is-ng'); };

    const update = () => {
      const price = Number(item.selectedOptions[0]?.dataset.price || 0);
      const ship = Number(item.selectedOptions[0]?.dataset.ship || 0);
      const n = Math.max(1, Math.min(50, Number(qty.value) || 1));
      total.textContent = (price * n + ship).toLocaleString('ja-JP');
    };
    const q = new URLSearchParams(location.search).get('item');
    if (q && [...item.options].some(o => o.value === q)) item.value = q;
    item.addEventListener('change', update);
    qty.addEventListener('input', update);
    update();

    // ご依頼主と同じ
    const same = document.getElementById('same') as HTMLInputElement;
    same.addEventListener('change', () => {
      if (!same.checked) return;
      (form.elements.namedItem('recipient_name') as HTMLInputElement).value = (form.elements.namedItem('sender_name') as HTMLInputElement).value;
      (form.elements.namedItem('recipient_tel') as HTMLInputElement).value = (form.elements.namedItem('sender_tel') as HTMLInputElement).value;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) { show('送信設定が未完了です。お手数ですがお電話またはLINEでご連絡ください。', false); return; }
      btn.disabled = true; show('送信中です…', true);
      try {
        const data = new URLSearchParams(new FormData(form) as any);
        data.set('item_name', item.selectedOptions[0].textContent || '');
        data.set('total_estimate', total.textContent || '');
        const res = await fetch(endpoint, { method: 'POST', body: data });
        const json = await res.json();
        if (!json.ok) throw new Error('rejected');
        const method = String(data.get('payment') || '');
        const square = (JSON.parse(form.dataset.square || '{}') as Record<string, string>)[String(data.get('item'))];
        const rakuten = form.dataset.rakuten || '';
        const card = document.getElementById('od-next-card') as HTMLAnchorElement;
        const rk = document.getElementById('od-next-rakuten')!;
        const lead = document.getElementById('od-next-lead')!;
        card.hidden = true; rk.hidden = true;
        if (method.includes('Square') && square) {
          card.href = square; card.hidden = false;
          lead.textContent = '下のボタンからカード決済にお進みください。お支払い確認後に発送の手配をいたします。';
        } else if (method.includes('楽天') && rakuten) {
          rk.textContent = rakuten; rk.hidden = false;
          lead.textContent = '楽天ペイの残高送金でお支払いください。送金の確認後に発送の手配をいたします。';
        } else {
          lead.textContent = '担当者より、お支払い方法とお届け日をメールでご案内します。';
        }
        form.hidden = true;
        const next = document.getElementById('od-next')!;
        next.hidden = false;
        next.scrollIntoView({ behavior: 'smooth', block: 'start' });
        show('', true);
      } catch {
        show('送信に失敗しました。お手数ですがお電話またはLINEでご連絡ください。', false);
      } finally { btn.disabled = false; }
    });
  }
</script>

<style>
.od-wrap { max-width: 760px; }
.od-form { display: flex; flex-direction: column; gap: 1.75rem; }
.od-box { border: .5px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem 1.75rem 1.75rem; background: #fff; display: flex; flex-direction: column; gap: 1.1rem; }
.od-box legend { font-weight: 700; font-size: .95rem; color: var(--amber); padding: 0 .6rem; }
.od-row { display: flex; gap: 1.1rem; flex-wrap: wrap; }
.od-group { display: flex; flex-direction: column; min-width: 140px; }
.od-grow { flex: 1; }
.req { color: #C02828; font-size: .85em; }
.od-total { margin: 0; font-size: .95rem; white-space: nowrap; }
.od-total strong { font-size: 1.4rem; color: var(--amber); font-family: Manrope, sans-serif; }
.od-pay { display: flex; flex-direction: column; gap: .6rem; }
.od-next { text-align: center; padding: 3rem 1.5rem; border: .5px solid var(--border); border-radius: var(--radius-md); background: var(--amber-pale); display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
.od-next[hidden], .od-form[hidden] { display: none; }
.od-next h2 { margin: 0; font-size: 1.3rem; }
.od-rakuten { white-space: pre-line; background: #fff; padding: 1rem 1.5rem; border-radius: var(--radius-sm); font-size: .9rem; line-height: 1.9; margin: 0; }
.od-hint { margin: 0; font-size: .75rem; color: var(--muted); line-height: 1.9; }
.od-check { display: flex; gap: .6rem; align-items: center; font-size: .85rem; }
.od-link { color: var(--amber); text-decoration: underline; }
.od-submit { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
.od-status { margin: 0; font-size: .85rem; min-height: 1.2em; }
.od-status.is-ok { color: #2A4A20; }
.od-status.is-ng { color: #C02828; }
.hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>
