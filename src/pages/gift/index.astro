---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import { gifts, giftNotes } from '../../data/gifts';

const scenes = ['お中元', 'お歳暮', '内祝い', '誕生日・お祝い', '手土産'];
const yen = (g: { price: number; shippingFee: number }) =>
  `${g.price.toLocaleString('ja-JP')}円（${g.shippingFee ? '送料別' : '送料込み'}）`;
---
<Layout title="ギフト・オンラインショップ｜小澤鶏卵" description="富山の鶏卵専門店・小澤鶏卵のギフト。お中元・お歳暮・内祝いに。卵かけご飯セットなどを、オンラインでご注文いただけます。">
  <Header/>
  <main>
    <PageHero en="Gift" ja="ギフト・オンラインショップ" img="/images/gift/tkg-set.webp" lead="お中元・お歳暮・内祝いに。富山のおいしいを、大切な方へお届けします。"><p style="text-align:center;margin:1.5rem 0 .5rem"><a href="#lineup" class="btn btn-primary">ギフトを選ぶ ↓</a></p></PageHero>

    <section class="sec">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Scene</h2><p class="ttl-ja">贈るシーン</p>
        </div>
        <ul class="scene-list">
          {scenes.map(s => <li class="scene-tag">{s}</li>)}
        </ul>
      </div>
    </section>

    <section class="sec sec--pale" id="lineup">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Line Up</h2><p class="ttl-ja">ギフト商品一覧</p>
        </div>
        <div class="gift-grid">
          {gifts.map((g, i) => (
            <article class={`card gift-card fade-up fade-up-d${(i % 4) + 1}`} id={g.id}>
              <div class="gift-slider" data-slider>
                <span class="gift-badge">{g.badge}</span>
                <div class="gift-track">
                  <div class="gift-img gift-slide">
                    <img src={g.img} alt={g.name} loading="lazy"/>
                  </div>
                  {g.img2 && <div class="gift-img gift-slide"><img src={g.img2} alt={`${g.name}の包装イメージ`} loading="lazy"/></div>}
                </div>
                {g.img2 && (
                  <>
                    <button type="button" class="gs-btn gs-prev" aria-label="前の画像">‹</button>
                    <button type="button" class="gs-btn gs-next" aria-label="次の画像">›</button>
                    <div class="gs-dots"><span class="is-on"></span><span></span></div>
                  </>
                )}
              </div>
              <div class="gift-body">
                <h3>{g.name}</h3>
                <p class="gift-desc">{g.desc}</p>
                <dl class="gift-meta">
                  <dt>内容</dt><dd>{g.contents}</dd>
                  <dt>おすすめ</dt><dd>{g.scenes.join('・')}</dd>
                </dl>
                <p class="gift-price">{yen(g)}</p>
                <p class="gift-ship">{g.shippingNote}</p>
                <a href={g.buyUrl || `/gift/order?item=${g.id}`} class="btn btn-primary gift-btn">注文する</a>
              </div>
            </article>
          ))}
        </div>
        <p class="gift-note-main">※価格・内容は変更になる場合があります。最新の情報は注文確認時にご案内します。</p>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Guide</h2><p class="ttl-ja">ご注文について</p>
        </div>
        <ol class="guide-steps">
          <li><span>01</span><div><h3>ギフトを選ぶ</h3><p>上の一覧からお好みのギフトをお選びください。</p></div></li>
          <li><span>02</span><div><h3>注文フォームで申込み</h3><p>「注文する」から注文フォームへ進み、数量・お届け先などを入力して送信します。</p></div></li>
          <li><span>03</span><div><h3>お届け</h3><p>確認メールでお支払い方法をご案内します。ご入金確認後、ご指定のお届け先へ新鮮なたまごをお届けします。</p></div></li>
        </ol>
        <ul class="guide-notes">
          {giftNotes.map(n => <li>{n}</li>)}
        </ul>
        <div style="text-align:center;margin-top:2.5rem">
          <a href="/gift/order" class="btn-circle">注文フォームへ</a>
          <a href="/delivery" class="btn-circle" style="margin-left:1rem">送料とお届けについて</a>
        </div>
      </div>
    </section>

    <section class="sec sec--amber">
      <div class="container" style="text-align:center">
        <h2 class="sec-title">法人のお客様へ</h2>
        <p class="sec-lead">お取引先への贈答や記念品など、まとまった数のご注文は個別にご相談ください。</p>
        <a href="/contact" class="btn btn-dark" style="margin-top:1.75rem">法人のご相談はこちら →</a>
      </div>
    </section>

    <ContactSection/>
  </main>
  <Footer/>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.gift-track')!;
    const dots = root.querySelectorAll<HTMLElement>('.gs-dots span');
    const go = (d: number) => track.scrollBy({ left: d * track.clientWidth });
    root.querySelector('.gs-prev')?.addEventListener('click', () => go(-1));
    root.querySelector('.gs-next')?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
    }, { passive: true });
  });
</script>

<style>
.scene-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }
.scene-tag { padding: .6rem 1.4rem; border: 1px solid rgba(186,117,23,.35); border-radius: 999px; background: var(--amber-pale); color: var(--amber); font-size: 1rem; font-weight: 700; letter-spacing: .06em; }
.gift-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 340px)); justify-content: center; gap: 3rem 1.75rem; }
.gift-img { position: relative; aspect-ratio: 1/1; background: var(--amber-pale); display: flex; align-items: center; justify-content: center; }
.gift-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gift-badge { position: absolute; top: -2.6rem; left: -1.2rem; z-index: 1; width: 4.1rem; height: 4.1rem; display: flex; align-items: center; justify-content: center; text-align: center; background: var(--brand); color: var(--on-brand); font-size: .75rem; font-weight: 700; line-height: 1.2; letter-spacing: 0; white-space: nowrap; border-radius: 50%; box-shadow: 0 1px 4px rgba(0,0,0,.25); }
.gift-slider { position: relative; }
.gift-card { overflow: visible; }
.gift-track { border-radius: var(--radius-md) var(--radius-md) 0 0; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
.gift-track::-webkit-scrollbar { display: none; }
.gift-slide { flex: 0 0 100%; scroll-snap-align: start; }
.gs-btn { position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.88); color: var(--text); font-size: 1.5rem; line-height: 1; cursor: pointer; box-shadow: 0 1px 6px rgba(0,0,0,.2); }
.gs-prev { left: .6rem; } .gs-next { right: .6rem; }
.gs-dots { position: absolute; left: 0; right: 0; bottom: .7rem; display: flex; justify-content: center; gap: .5rem; }
.gs-dots span { width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,.7); box-shadow: 0 0 3px rgba(0,0,0,.35); }
.gs-dots span.is-on { background: var(--brand); }
.gift-card { display: flex; flex-direction: column; }
.gift-body { flex: 1; padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; }
.gift-body h3 { font-size: 1.02rem; margin: 0; }
.gift-desc { font-size: .97rem; color: var(--muted); line-height: 1.9; margin: 0; }
.gift-meta { display: grid; grid-template-columns: auto 1fr; gap: .35rem .85rem; margin: 0; font-size: .92rem; }
.gift-meta dt { color: var(--amber); font-weight: 700; }
.gift-meta dd { margin: 0; color: var(--text); }
.gift-ship { font-size: .88rem; color: var(--muted); line-height: 1.8; margin: 0; }
.gift-price { font-size: 1.15rem; font-weight: 700; margin: .25rem 0 0; }
.gift-btn { justify-content: center; padding: .85rem 1rem; margin-top: auto; }
.gift-note-main { text-align: center; font-size: .88rem; color: var(--muted); margin-top: 2rem; }
.guide-steps { list-style: none; margin: 0 auto; padding: 0; max-width: 820px; display: grid; gap: 1rem; }
.guide-steps li { display: flex; gap: 1.5rem; align-items: center; padding: 1.4rem 1.75rem; border: .5px solid var(--border); border-radius: var(--radius-md); background: #fff; }
.guide-steps li > span { font-family: Manrope, sans-serif; font-size: 1.6rem; font-weight: 700; color: var(--amber); }
.guide-steps h3 { font-size: .98rem; margin: 0 0 .25rem; }
.guide-steps p { font-size: .97rem; color: var(--muted); line-height: 1.8; margin: 0; }
.guide-notes { max-width: 820px; margin: 1.75rem auto 0; padding-left: 1.2rem; font-size: .95rem; color: var(--muted); line-height: 2; }
@media (max-width: 600px) { .guide-steps li { flex-direction: column; align-items: flex-start; gap: .5rem; } }
</style>
