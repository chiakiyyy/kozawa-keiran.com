---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { products } from '../data/products';
import { metrics, works } from '../data/works';
import { stores } from '../data/stores';
import { gifts } from '../data/gifts';
import { commitments, processSteps } from '../data/commitment';

const gift = gifts[0];
const yen = (n: number) => n.toLocaleString('ja-JP');

// 画像は仮。差し替える場合はここのパスを変更する
const services = [
  { label: '業務用たまご（法人のお客様）', href: '/business', img: '/images/business_hero.png' },
  { label: 'ギフト・オンライン注文',       href: '/gift',     img: '/images/gift/tkg-set.webp' },
  { label: '個人のお客様',                 href: '/shop',     img: '/images/shop/hero-family.jpg' },
];
const workImgs = ['/images/feature/feature-egg.jpg', '/images/hero_main.png', '/images/shop/point4.jpg', '/images/feature/feature-factory.jpg', '/images/shop/hero-family.jpg', '/images/business_hero.png'];
const news = [
  { date: '2024.05.01', tag: 'お知らせ', title: 'ゴールデンウィーク期間の営業について' },
  { date: '2024.04.10', tag: '重要',     title: '「こだわりのたまご」価格改定のお知らせ' },
  { date: '2024.03.15', tag: 'お知らせ', title: 'ホームページをリニューアルしました' },
];
---
<Layout title="小澤鶏卵｜富山の業務用たまご・鶏卵専門店｜当日配達対応" description="富山県の鶏卵専門店・小澤鶏卵。大正時代創業100年以上。富山市を中心に飲食店・ホテル・給食施設・スーパーへ業務用たまごを当日配達。ギフトのオンライン注文、定期納品、催事対応も承ります。">
  <Header/>
  <main>

    <!-- HERO -->
    <section class="hf">
      <div class="hf-img">
        <img src="/images/hero_main.png" alt="小澤鶏卵のたまご" loading="eager"/>
        <h1 class="sr-only">小澤鶏卵 - 富山の業務用たまご・鶏卵専門店。当日配達対応。</h1>
        <div class="hf-news">
          <div class="hf-news-body">
            <div><b>News</b><span>{news[0].date}</span></div>
            <div>{news[0].title}</div>
          </div>
          <a href="/news" class="circle-link">View more</a>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <div class="intro-panel fade-up">
        <img src="/images/shop/hero-family.jpg" alt="たまごのある食卓" loading="lazy"/>
      </div>
      <div class="intro-copy fade-up">
        <p class="intro-catch">幸せは、<br/>たまごのある食卓にある。</p>
        <p class="intro-en">Happiness is a table with eggs.</p>
        <p class="intro-body">おひさまを浴びる幸せ。新鮮なものを食べる幸せ。<br/>安心できるものを選べる幸せ。<br/><br/>大正時代の創業から100年以上、富山の食卓と飲食店を<br/>たまごで支えてきました。</p>
        <a href="/about" class="circle-link">About us</a>
      </div>
    </section>

    <!-- STORY -->
    <section class="story">
      <div class="story-in">
        <div class="story-head fade-up">
          <div class="ttl ttl--left"><h2 class="ttl-en">Story</h2><p class="ttl-ja">これまでの歩み</p></div>
          <p class="story-catch serif">たまごひとつに、<br/>百年分の毎日がある。</p>
        </div>
        <div class="story-body fade-up">
          <p>大正の頃から、私たちはたまごを扱ってきました。</p>
          <p>朝、鶏舎で産みたてのたまごを手に取る。その毎日を、受け継ぎながら重ねてきました。</p>
          <p>時代が変わり、食卓も、お店も変わりました。それでも変わらないのは、食べる人の顔を思い浮かべて、たまごを届けるということです。</p>
          <p>ラーメン店の厨房へ、菓子店の仕込み場へ、給食室へ、そして家族の朝ごはんへ。</p>
          <p>富山の暮らしのすぐそばで、これからもたまごを届けつづけます。</p>
          <ol class="story-line">
            <li><b>大正時代</b><span>富山で鶏卵の商いを始める</span></li>
            <li><b>それから100年以上</b><span>鶏卵ひと筋に、富山の食卓と飲食店を支える</span></li>
            <li><b>現在</b><span>飲食店・菓子店・スーパー・施設など、{stores.length}件の取引先へお届け</span></li>
            <li><b>これから</b><span>ギフトのオンライン注文を始め、より多くの食卓へ</span></li>
          </ol>
          <a href="/about" class="circle-link">私たちについて</a>
        </div>
      </div>
    </section>

    <!-- COMMITMENT -->
    <section class="sec">
      <div class="container wide">
        <div class="ttl fade-up"><h2 class="ttl-en">Commitment</h2><p class="ttl-ja">小澤鶏卵のこだわり</p></div>
        <div class="cm-grid">
          {commitments.map(c => (
            <article class="cm fade-up">
              <div class="cm-img"><img src={c.img} alt="" loading="lazy"/><span class="cm-num">{c.num}</span></div>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
        <div style="text-align:center;margin-top:3.5rem"><a href="/feature" class="btn-circle">こだわりをもっと見る</a></div>
      </div>
    </section>

    <!-- SERVICE -->
    <section class="band">
      <div class="band-in">
        <div>
          <div class="ttl ttl--left"><h2 class="ttl-en">Service</h2><p class="ttl-ja">事業内容</p></div>
          <p>富山市を中心に、飲食店・ホテル・給食施設・スーパーなどへ業務用たまごの卸売をおこなっています。<br/><br/>大量注文・定期納品・催事対応のほか、ギフトのオンライン注文、個人のお客様への販売も承ります。</p>
          <p id="svc-links" style="margin-top:2rem">
            <a id="svc-link" href={services[0].href} class="circle-link circle-link--w">詳しく見る</a>
          </p>
        </div>
        <div class="halo" id="halo">
          {services.map((s, i) => (
            <a href={s.href} class={`halo-slide${i === 0 ? ' on' : ''}`} data-href={s.href} aria-label={s.label}>
              <img src={s.img} alt="" loading="lazy"/>
            </a>
          ))}
          <div class="halo-label" id="halo-label">{services[0].label}</div>
          <button class="halo-btn halo-btn--prev" id="halo-prev" aria-label="前へ">&lt;</button>
          <button class="halo-btn halo-btn--next" id="halo-next" aria-label="次へ">&gt;</button>
        </div>
      </div>
    </section>

    <!-- WORKS -->
    <section class="sec works-sec">
      <div class="container">
        <div class="works-head">
          <div class="ttl ttl--left" style="margin:0"><h2 class="ttl-en">Works</h2><p class="ttl-ja">卸売の実績</p></div>
          <a href="/works" class="circle-link">View all</a>
        </div>
        <ul class="metric-row">
          {metrics.map(m => (
            <li><span class="metric-row-num">{m.num}<small>{m.unit}</small></span><span class="metric-row-label">{m.label}</span></li>
          ))}
        </ul>
      </div>
      <div class="hscroll">
        {works.map((w, i) => (
          <a href="/works" class="hcard">
            <div class="hcard-img"><img src={workImgs[i % workImgs.length]} alt="" loading="lazy"/><span class="hcard-tag">{w.category}</span></div>
            <h3>{w.title}</h3>
          </a>
        ))}
      </div>
    </section>

    <!-- PROCESS -->
    <section class="sec sec--panel">
      <div class="container wide">
        <div class="ttl fade-up"><h2 class="ttl-en">Process</h2><p class="ttl-ja">採卵から食卓へ・出荷までの流れ</p></div>
        <ol class="pr-list">
          {processSteps.map(st => (
            <li class="pr fade-up">
              <span class="pr-num">{st.num}</span>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </li>
          ))}
        </ol>
        <div style="text-align:center;margin-top:3rem"><a href="/flow" class="btn-circle">出荷の流れを見る</a></div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="sec">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Products handled</h2><p class="ttl-ja">取り扱い商品</p></div>
        <p class="sec-lead" style="text-align:center;margin:-1.5rem auto 3.5rem;max-width:640px">富山の鶏卵専門店として、用途に合わせた各種たまごを取り揃えています。</p>
        <div class="circ-grid">
          {products.filter(p => ['kodawari','pink','araucana','gift'].includes(p.id)).map(p => (
            <a href={`/products#${p.id}`} class="circ fade-up">
              <div class="circ-ring"><img src={p.img} alt={p.name} loading="lazy"/></div>
              <h3>{p.name}</h3>
              <p>{p.note}</p>
            </a>
          ))}
        </div>
        <div style="text-align:center;margin-top:3.5rem"><a href="/products" class="btn-circle">商品一覧を見る</a></div>
      </div>
    </section>

    <!-- GIFT -->
    <section class="gift-sec">
      <div class="gift-in">
        <div class="gift-photo fade-up"><img src={gift.img} alt={gift.name} loading="lazy"/></div>
        <div class="fade-up">
          <div class="ttl ttl--left"><h2 class="ttl-en">Gift</h2><p class="ttl-ja">ギフト・オンライン注文</p></div>
          <h3 class="gift-name">{gift.name}</h3>
          <p class="gift-desc">{gift.desc}</p>
          <p class="gift-price"><strong>{yen(gift.price)}</strong>円<small>（送料込み）</small></p>
          <div class="gift-btns">
            <a href="/gift" class="btn-circle">ギフト一覧を見る</a>
            <a href={`/gift/order?item=${gift.id}`} class="btn btn-primary">注文する</a>
          </div>
        </div>
      </div>
    </section>

    <!-- STORES + NEWS -->
    <section class="sec">
      <div class="container two">
        <div>
          <div class="ttl ttl--left"><h2 class="ttl-en">Stores</h2><p class="ttl-ja">取扱店舗</p></div>
          <p class="sec-lead" style="margin:0 0 1.8rem">飲食店・菓子店・スーパー・施設など、{stores.length}件の取引先を業態・エリア別にご紹介します。</p>
          <a href="/stores" class="circle-link">View all</a>
        </div>
        <div>
          <div class="ttl ttl--left"><h2 class="ttl-en">News</h2><p class="ttl-ja">お知らせ</p></div>
          <ul class="news-list2">
            {news.map(n => (
              <li><a href="/news"><span class="n-date">{n.date}</span><span class={`n-tag${n.tag === '重要' ? ' n-tag--imp' : ''}`}>{n.tag}</span><span class="n-title">{n.title}</span></a></li>
            ))}
          </ul>
          <a href="/news" class="circle-link" style="margin-top:1.5rem">View all</a>
        </div>
      </div>
    </section>

    <ContactSection/>
  </main>
  <Footer/>
</Layout>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.halo-slide'));
  const label = document.getElementById('halo-label');
  const link = document.getElementById('svc-link') as HTMLAnchorElement | null;
  const labels = slides.map(s => s.getAttribute('aria-label') || '');
  let cur = 0;
  const go = (n: number) => {
    cur = (n + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle('on', i === cur));
    if (label) label.textContent = labels[cur];
    if (link) link.href = slides[cur].dataset.href || '/';
  };
  document.getElementById('halo-prev')?.addEventListener('click', () => go(cur - 1));
  document.getElementById('halo-next')?.addEventListener('click', () => go(cur + 1));
</script>

<style>
.story { background: var(--deep); color: #F4EBDD; padding: 6.5rem 0; }
.story .ttl-en { color: #fff; } .story .ttl-ja { color: #E8C98F; }
.story-in { max-width: 1100px; margin: 0 auto; padding: 0 2.5rem; display: grid; grid-template-columns: 1fr 1.25fr; gap: 4rem; }
.story-catch { font-size: clamp(1.7rem, 3.4vw, 2.5rem); line-height: 1.9; letter-spacing: .14em; margin: 2.5rem 0 0; color: #fff; font-weight: 500; }
.story-body p { font-family: 'Shippori Mincho', 'Zen Kaku Gothic New', serif; font-size: 1.02rem; line-height: 2.5; letter-spacing: .12em; margin: 0 0 1.4rem; color: rgba(244,235,221,.92); }
.story-line { list-style: none; margin: 2.5rem 0 2rem; padding: 0 0 0 1.5rem; border-left: 1px solid rgba(232,201,143,.5); display: grid; gap: 1.4rem; }
.story-line li { position: relative; display: grid; gap: .2rem; }
.story-line li::before { content: ''; position: absolute; left: calc(-1.5rem - 5px); top: .7em; width: 9px; height: 9px; border-radius: 50%; background: #E8C98F; }
.story-line b { font-family: 'Shippori Mincho', serif; font-size: 1.05rem; color: #E8C98F; letter-spacing: .1em; font-weight: 500; }
.story-line span { font-size: .9rem; color: rgba(244,235,221,.85); line-height: 1.9; }
@media (max-width: 860px) { .story-in { grid-template-columns: 1fr; gap: 1rem; padding: 0 1.5rem; } }
.wide { max-width: 1180px; }
.sec--panel { background: var(--panel); }
.cm-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 3rem 2rem; }
.cm { grid-column: span 2; }
.cm:nth-child(n+4) { grid-column: span 3; }
.cm-img { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 3/2; background: var(--panel); }
.cm-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cm-num { position: absolute; left: 1rem; top: .6rem; color: #fff; font-family: Manrope, sans-serif; font-weight: 300; font-size: 2.2rem; letter-spacing: .06em; text-shadow: 0 1px 10px rgba(0,0,0,.35); }
.cm h3 { margin: 1.1rem 0 .5rem; font-size: 1.1rem; color: var(--amber); letter-spacing: .08em; }
.cm p { margin: 0; font-size: .92rem; line-height: 2; color: var(--muted); }
.pr-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.5rem; position: relative; }
.pr-list::before { content: ''; position: absolute; top: 26px; left: 8%; right: 8%; border-top: 1px dashed rgba(186,117,23,.5); }
.pr { position: relative; text-align: center; }
.pr-num { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--amber); color: #fff; font-family: Manrope, sans-serif; font-weight: 500; letter-spacing: .04em; position: relative; z-index: 1; }
.pr h3 { margin: 1rem 0 .4rem; font-size: 1rem; }
.pr p { margin: 0; font-size: .85rem; line-height: 1.9; color: var(--muted); text-align: left; }
@media (max-width: 960px) { .cm-grid { grid-template-columns: 1fr 1fr; } .cm, .cm:nth-child(n+4) { grid-column: span 1; } .pr-list { grid-template-columns: repeat(2, 1fr); } .pr-list::before { display: none; } }
@media (max-width: 600px) { .cm-grid { grid-template-columns: 1fr; } }
.intro { background: #fff; padding: 5rem 1.5rem 6rem; }
.intro-panel { max-width: 1100px; margin: 0 auto; background: var(--panel); padding: 6% 9% 9%; }
.intro-panel img { width: 100%; aspect-ratio: 2/1; object-fit: cover; border-radius: 16px; display: block; }
.intro-copy { max-width: 1100px; margin: -5rem auto 0; padding-left: 9%; position: relative; }
.intro-catch { font-family: 'Shippori Mincho', 'Zen Kaku Gothic New', serif; font-size: clamp(1.8rem, 4vw, 2.8rem); color: var(--amber); letter-spacing: .12em; line-height: 1.8; font-weight: 400; margin: 0; background: #fff; display: inline-block; padding: 1rem 2rem 0 0; }
.intro-en { color: var(--amber-lt); font-family: Manrope, sans-serif; font-size: .85rem; letter-spacing: .12em; margin: .6rem 0 2rem; }
.intro-body { color: var(--amber); font-size: .92rem; line-height: 2.3; letter-spacing: .1em; margin: 0 0 2rem; }
.works-sec { padding-bottom: 5rem; }
.works-sec :global(.container) { max-width: 1120px; }
.works-sec :global(.hscroll) { padding-left: max(2.5rem, calc((100vw - 1120px) / 2 + 2.5rem)); }
.works-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; gap: 1rem; }
.metric-row { list-style: none; margin: 0 0 3rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem; }
.metric-row li { display: flex; flex-direction: column; gap: .3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
.metric-row-num { font-family: Manrope, sans-serif; font-weight: 300; font-size: clamp(1.9rem, 3.4vw, 2.6rem); color: var(--amber); line-height: 1.2; }
.metric-row-num small { font-size: .85rem; margin-left: .2rem; font-weight: 500; }
.metric-row-label { font-size: .8rem; letter-spacing: .1em; color: var(--muted); }
.gift-sec { background: var(--panel); padding: 6rem 0; }
.gift-in { max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.gift-photo img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 24px; display: block; }
.gift-name { font-size: 1.25rem; margin: 0 0 1rem; }
.gift-desc { font-size: .88rem; line-height: 2.1; color: var(--muted); margin: 0 0 1.2rem; }
.gift-price { margin: 0 0 1.8rem; font-size: 1rem; } .gift-price strong { font-family: Manrope, sans-serif; font-size: 2rem; font-weight: 500; }
.gift-price small { font-size: .78rem; color: var(--muted); margin-left: .4rem; }
.gift-btns { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
.two { display: grid; grid-template-columns: 1fr 1.3fr; gap: 4rem; max-width: 1100px; }
.news-list2 { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
.news-list2 li { border-bottom: 1px solid var(--border); }
.news-list2 a { display: flex; gap: 1rem; align-items: center; padding: 1.1rem .3rem; text-decoration: none; color: inherit; flex-wrap: wrap; }
.n-date { font-family: Manrope, sans-serif; font-size: .78rem; color: var(--muted); }
.n-tag { font-size: .68rem; background: var(--amber-bg); color: var(--amber); padding: .15rem .7rem; border-radius: 999px; font-weight: 700; }
.n-tag--imp { background: #FBE3E0; color: #B3261E; }
.n-title { font-size: .88rem; }
@media (max-width: 860px) { .gift-in, .two { grid-template-columns: 1fr; gap: 2.5rem; } .intro-panel { padding: 8% 6% 12%; } .intro-copy { padding-left: 6%; margin-top: -3rem; } .intro-catch { padding-right: 1rem; } }
</style>
