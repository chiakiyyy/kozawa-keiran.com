@media (max-width: 640px) { .cc-egg.he1 { width: 120px; left: -64px; top: 64%; } .cc-egg.he3 { width: 130px; right: -70px; top: 4%; } .cc-egg.he2, .cc-egg.he4 { width: 46px; } .cc-egg.he2 { left: 5%; bottom: 4%; } .cc-egg.he4 { right: 6%; bottom: 3%; } }

/* その下の帯：黄色が続かないよう、白い帯に変える */
