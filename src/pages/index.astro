.tp-biz-intro-text h3 { margin: 0 0 1.2rem; font-family: 'Zen Maru Gothic', 'Zen Kaku Gothic New', sans-serif; font-weight: 700; font-size: clamp(1.3rem, 2.2vw, 1.7rem); line-height: 1.7; letter-spacing: .06em; }
.tp-biz-intro-text p { margin: 0; line-height: 2.1; }
.tp-biz-points-ttl { text-align: center; margin: 0 0 2.5rem; font-family: 'Zen Maru Gothic', 'Zen Kaku Gothic New', sans-serif; font-weight: 700; font-size: clamp(1.3rem, 2.2vw, 1.7rem); letter-spacing: .08em; }
.tp-biz-points-ttl span { color: var(--cta); }
.tp-biz-circles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
