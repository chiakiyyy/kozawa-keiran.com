  .tp-split-panel { padding: 3rem 1.5rem; }
}

/* ---- メッセージエリアを黄色に／卵形をメッセージエリアへ ---- */
.hero-wave path { fill: var(--soft); }
.tp-concept { position: relative; overflow: hidden; background: var(--soft); }
.tp-concept > .tp-vert, .tp-concept > .tp-concept-lead { position: relative; z-index: 1; }
.tp-concept .tp-vert .ac { color: var(--cta); }
.cc-egg { position: absolute; z-index: 0; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; pointer-events: none; }
.cc-egg.he1 { width: clamp(150px, 17vw, 260px); aspect-ratio: 4/5; left: calc(clamp(150px, 17vw, 260px) * -.4); top: 38%; background: #fff; transform: rotate(-12deg); }
.cc-egg.he2 { width: clamp(64px, 6.5vw, 100px); aspect-ratio: 4/5; left: 9%; bottom: 12%; background: var(--peach); transform: rotate(14deg); }
.cc-egg.he3 { width: clamp(160px, 18vw, 280px); aspect-ratio: 4/5; right: calc(clamp(160px, 18vw, 280px) * -.38); top: 10%; background: #fff; transform: rotate(16deg); }
