---
import { dim } from '../data/imgsize';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { productGroups } from '../data/products';
import { metrics, works } from '../data/works';
import { stores } from '../data/stores';
import { gifts } from '../data/gifts';
import { commitments } from '../data/commitment';
import { news } from '../data/news';

const gift = gifts[0];
const yen = (n: number) => n.toLocaleString('ja-JP');

const entries = [
  { label: '法人のお客様', egg: '/images/entry/egg-biz.webp', href: '/business/', img: '/images/business_hero.png', art: '/images/illust-biz.png', illus: `<svg viewBox="0 0 120 120" aria-hidden="true"><rect x="8" y="42" width="62" height="40" rx="4" fill="#fff" stroke="#643E2F" stroke-width="3"/><path d="M70 54h18l14 14v14H70z" fill="#CF470E" stroke="#643E2F" stroke-width="3" stroke-linejoin="round"/><path d="M77 58h10l8 9H77z" fill="#FFF6CC"/><circle cx="28" cy="86" r="9" fill="#643E2F"/><circle cx="88" cy="86" r="9" fill="#643E2F"/><circle cx="28" cy="86" r="3.5" fill="#fff"/><circle cx="88" cy="86" r="3.5" fill="#fff"/><ellipse cx="39" cy="61" rx="10" ry="12.5" fill="#FFE200" stroke="#643E2F" stroke-width="2.5"/><path d="M8 74h62" stroke="#CF470E" stroke-width="3"/></svg>`, bg: '#FBE7D5', desc: '飲食店・ホテル・給食施設・スーパーなどへ、業務用たまごを当日配達します。', go: '法人のお客様はこちら' },
  { label: 'オンラインショップ', egg: '/images/entry/egg-shop.webp', href: '/gift/', img: '/images/gift/tkg-set.webp', illus: `<svg viewBox="0 0 120 120" aria-hidden="true"><rect x="34" y="12" width="52" height="96" rx="10" fill="#fff" stroke="#643E2F" stroke-width="3"/><rect x="40" y="24" width="40" height="52" rx="3" fill="#FFF6CC"/><ellipse cx="60" cy="48" rx="10" ry="13" fill="#FFE200" stroke="#643E2F" stroke-width="2.5"/><rect x="42" y="82" width="36" height="14" rx="7" fill="#CF470E"/><path d="M52 89h16" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>`, bg: '#FFF0C2', desc: 'ギフトや、ご家庭用のたまごを、オンラインでご注文いただけます。', go: 'ご注文はこちら' },
  { label: '直売所のご案内', egg: '/images/entry/egg-store.webp', href: '/store/', img: '/images/shop/hero-family.jpg', illus: `<svg viewBox="0 0 120 120" aria-hidden="true"><rect x="20" y="56" width="80" height="48" fill="#fff" stroke="#643E2F" stroke-width="3"/><path d="M14 56l8-24h76l8 24z" fill="#CF470E" stroke="#643E2F" stroke-width="3" stroke-linejoin="round"/><path d="M42 32l-6 24M60 32v24M78 32l6 24" stroke="#fff" stroke-width="5"/><rect x="48" y="72" width="24" height="32" fill="#FFE200" stroke="#643E2F" stroke-width="3"/><ellipse cx="60" cy="19" rx="7" ry="9" fill="#FFE200" stroke="#643E2F" stroke-width="2.5"/><path d="M26 74h14v12H26z" fill="#FFF6CC" stroke="#643E2F" stroke-width="2"/></svg>`, bg: '#E6EEF2', desc: '富山市婦中町の店舗です。所在地と営業時間をご案内します。', go: 'アクセスを見る' },
];
const storeRows = [
  ['所在地', '〒939-2716 富山県富山市婦中町下轡田25-1'],
  ['電話番号', '076-466-3815'],
  ['営業時間', '月〜土 8:00〜17:00（日曜・祝日は休業）'],
];
const bizPoints = [
  { title: '富山市内へ自社配送', body: '<span class="nw">温度を管理して、</span><span class="nw">自社便で</span><span class="nw">お届けします</span>' },
  { title: '10kg箱などの業務用商品', body: '<span class="nw">LL〜Sのサイズや、</span><span class="nw">赤玉も</span><span class="nw">ご相談ください</span>' },
  { title: '定期納品・数量のご相談', body: '<span class="nw">仕込みに合わせた</span><span class="nw">定期納品や、</span><span class="nw">数量の増減も</span><span class="nw">ご相談ください</span>' },
  { title: '法人向け請求書払い', body: '<span class="nw">掛け売りに</span><span class="nw">対応しています</span>' },
];
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('富山県富山市婦中町下轡田25-1');
const workImgs = ['/images/feature/feature-egg.jpg', '/images/hero_main.png', '/images/shop/point4.jpg', '/images/feature/feature-factory.jpg', '/images/shop/hero-family.jpg', '/images/business_hero.png'];
---
<Layout title="富山の卵卸・業務用たまご・卵ギフト通販｜小澤鶏卵" description="富山の鶏卵専門店・小澤鶏卵。1945年創業。飲食店・洋菓子店・ホテル・給食施設へ業務用たまご（10kg箱・パック卵）を卸売・配達しています。卵かけご飯セットなどのたまごギフトも、オンラインでご注文いただけます。">
  <Header/>
  <main>

    <!-- HERO -->
    <section class="hero">
      <img src="/images/hero-top.webp" alt="小澤鶏卵のたまご" loading="eager" width="1672" height="941"/>
      <svg class="hero-wave" viewBox="0 0 1440 50" preserveAspectRatio="none" aria-hidden="true"><path d="M0 26C25 24 95 15 150 16C205 17 272 31 330 32C388 33 440 20 500 20C560 20 633 34 690 34C747 34 787 18 840 17C893 16 953 30 1010 30C1067 30 1128 19 1180 19C1232 19 1277 30 1320 31C1363 32 1420 25 1440 24V50H0Z"/></svg>
    </section>

    <!-- 01 ファーストビュー -->
    <section class="tp-concept tp-fv">
      <span class="cc-egg he1" aria-hidden="true"></span><span class="cc-egg he2" aria-hidden="true"></span><span class="cc-egg he3" aria-hidden="true"></span><span class="cc-egg he4" aria-hidden="true"></span>
      <h1 class="tp-fv-h1 fade-up">富山の鶏卵専門店・小澤鶏卵<span>業務用たまごの卸売と、たまごギフトのお取り寄せ</span></h1>
      <div class="tp-vert fade-up">
        <p>富山の<span class="ac">食卓</span>と、</p>
        <p><span class="ac">まちのお店</span>へ。</p>
      </div>
      <p class="tp-concept-lead fade-up">1945年創業。<br/>富山でたまごを届け続ける、小澤鶏卵。</p>
      <div class="tp-fv-cta fade-up">
        <a href="/business/" class="tp-btn tp-btn--red"><i class="tp-ic tp-ic--arrow" aria-hidden="true"></i>法人のお客様へ</a>
        <a href="/gift/" class="tp-btn tp-btn--gold">ギフト・ご自宅用はこちら</a>
      </div>
    </section>

    <!-- 02 目的別の3つの入口 -->
    <section class="tp-entry-wrap">
      <div class="tp-entry fade-up">
        <div class="tp-entry-head">
          <p class="tp-entry-sub">ご用途に合わせて、お選びください</p>
          <h2 class="tp-entry-ttl">お探しの内容</h2>
        </div>
        <div class="tp-entry-items">
          {entries.map(e => (
            <a href={e.href} class="tp-egg-link">
              <span class="tp-egg tp-egg--img"><img src={e.egg} alt={e.label} loading="lazy" width="1127" height="1396"/></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 業務用たまごのご案内 -->
    <section class="tp-biz">
      <div class="tp-biz-in">
        <div class="tp-biz-head fade-up">
          <p class="tp-lineup-sub">業務用たまごのご案内</p>
          <h2 class="tp-lineup-ttl">毎日使うたまごを、<br/>安心してお届け。</h2>
          <p class="tp-lineup-lead">飲食店・洋菓子店・ホテル・給食施設・小売店など、富山の事業者様へ。用途や必要な数量に合わせて、業務用たまごのご相談を承っています。</p>
        </div>
        <div class="tp-biz-intro fade-up">
          <div class="tp-biz-frame"><img src="/images/business_hero.png" width="1536" height="1024" alt="たまごを積み込む配送の様子" loading="lazy"/></div>
          <div class="tp-biz-intro-text">
            <h3>富山の事業者様の、<br/>毎日の仕込みに。</h3>
            <p>10kg箱やパック卵を、ご注文の数量に合わせてお届けしています。富山市内は、月・水・金の午前9:30までのご注文で、当日夕方に配達します。</p>
          </div>
        </div>
        <p class="tp-biz-points-ttl fade-up">小澤鶏卵の<span>業務用たまご</span></p>
        <ul class="tp-biz-circles">
          {bizPoints.map((p, i) => (
            <li class="fade-up"><img class="tp-biz-ico" src={`/images/biz/num-${String(i + 1).padStart(2, '0')}.webp`} alt={`${String(i + 1).padStart(2, '0')}`} width="360" height="360" loading="lazy"/><h3>{p.title}</h3><p set:html={p.body}></p></li>
          ))}
        </ul>
        <div class="tp-more"><a href="/business/" class="tp-btn tp-btn--red"><i class="tp-ic tp-ic--arrow" aria-hidden="true"></i>業務用たまごのご相談はこちら</a></div>
      </div>
    </section>

    <!-- 04 取扱商品 -->
    <section class="tp-lineup tp-lineup--biz">
      <div class="tp-lineup-head fade-up">
        <p class="tp-lineup-sub">取扱商品</p>
        <h2 class="tp-lineup-ttl">用途に合わせた、<br/>さまざまなたまご。</h2>
        <p class="tp-lineup-lead">10kg箱からパック卵、ブランド卵、うずら卵まで。<br/>用途に合わせてお選びいただけます。</p>
      </div>
      <div class="tp-grid tp-grid--4">
        {productGroups.map(g => (
          <article class="tp-card fade-up">
            <a href={`/products/#${g.id}`} class="tp-card-img"><img src={g.img} {...dim(g.img)} alt={g.name} loading="lazy"/></a>
            <h3>{g.name}</h3>
            <div class="tp-card-btns">
              <a href={`/products/#${g.id}`} class="tp-btn tp-btn--red"><i class="tp-ic tp-ic--arrow" aria-hidden="true"></i>詳しく見る</a>
            </div>
          </article>
        ))}
      </div>
      <div class="tp-more"><a href="/products/" class="tp-btn tp-btn--red"><i class="tp-ic tp-ic--arrow" aria-hidden="true"></i>取扱商品を詳しく見る</a></div>
    </section>

    <!-- 05 個人向け・オンラインショップ -->
    <section class="tp-lineup tp-lineup--cream" id="home">
      <div class="tp-lineup-head fade-up">
        <p class="tp-lineup-sub">個人のお客様・オンラインショップ</p>
        <h2 class="tp-lineup-ttl">ご家庭にも、<br/>大切な方にも。</h2>
        <p class="tp-lineup-lead">毎日の食卓に。大切な方への贈り物に。<br/>小澤鶏卵のたまごをお届けします。</p>
      </div>
      <div class="tp-grid">
        {gifts.slice(0, 3).map(g => (
          <article class="tp-card fade-up">
            <a href="/gift/" class="tp-card-img"><img src={g.img} {...dim(g.img)} alt={g.name} loading="lazy"/></a>
            <h3>{g.name}</h3>
            <p class="tp-card-contents">{g.contents}</p>
            <p class="tp-card-price"><strong>{yen(g.price)}</strong>円<small>{g.shippingFee === 0 ? '（送料込み）' : `（送料${yen(g.shippingFee)}円）`}</small></p>
            <div class="tp-card-btns">
              <a href="/gift/" class="tp-btn tp-btn--red"><i class="tp-ic tp-ic--arrow" aria-hidden="true"></i>商品の詳細へ</a>
              <a href={`/gift/order/?item=${g.id}`} class="tp-btn tp-btn--gold"><svg class="tp-ic-cart" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.2a1.5 1.5 0 0 0 1.5 1.2h8.8a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/></svg>注文する</a>
            </div>
          </article>
        ))}
      </div>
      <div class="tp-more"><a href="/gift/" class="tp-btn tp-btn--line">オンラインショップを見る</a></div>
    </section>

    <!-- 06 私たちについて -->
    <section class="tp-about">
      <div class="tp-about-photo fade-up"><img src="/images/shop/point1.jpg" width="1536" height="1024" alt="富山の風景" loading="lazy"/></div>
      <div class="tp-about-body">
        <div class="tp-about-text fade-up">
          <p>富山の暮らしとともに歩んできた小澤鶏卵。飲食店の厨房へ、ご家庭の食卓へ、たまごをお届けしてきました。</p>
          <p>これからも、富山の毎日のそばで、たまごをお届けします。</p>
          <a href="/about/" class="tp-btn tp-btn--red"><i class="tp-ic tp-ic--arrow" aria-hidden="true"></i>小澤鶏卵について</a>
        </div>
        <h2 class="tp-vert tp-about-ttl fade-up"><span class="ln">富山で<span class="tcy">80</span>年以上、</span><span class="ln ac">たまごひと筋。</span></h2>
      </div>
      <div class="tp-about-row">
        {commitments.slice(0, 3).map(c => (<div class="tp-about-cell"><img src={c.img} {...dim(c.img)} alt={c.title} loading="lazy"/></div>))}
        <svg class="tp-about-wave" viewBox="0 0 1440 50" preserveAspectRatio="none" aria-hidden="true"><path d="M0 26C25 24 95 15 150 16C205 17 272 31 330 32C388 33 440 20 500 20C560 20 633 34 690 34C747 34 787 18 840 17C893 16 953 30 1010 30C1067 30 1128 19 1180 19C1232 19 1277 30 1320 31C1363 32 1420 25 1440 24V50H0Z"/></svg>
      </div>
    </section>

    <!-- 07 お問い合わせ -->
    <ContactSection title="たまごのことなら、お気軽にご相談ください。" lead="法人のお取引のご相談、商品やギフトのお問い合わせは、お電話・LINE・フォームからどうぞ。"/>
  </main>
  <Footer/>
</Layout>


<style>
.hero { position: relative; height: clamp(420px, 66vh, 720px); background: #e9e2d2; }
.hero > img { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; display: block; }
.hero-wave { position: absolute; left: 0; bottom: -1px; width: 100%; height: clamp(22px, 3.2vw, 46px); display: block; }
.hero-wave path, .tp-about-wave path { fill: var(--bg); }
@media (max-width: 640px) { .hero { height: clamp(300px, 46vh, 400px); } .hero > img { object-position: 68% center; } }

/* 縦書き */
.tp-vert { height: fit-content; writing-mode: vertical-rl; font-family: 'Shippori Mincho', 'Zen Kaku Gothic New', serif; font-weight: 500; letter-spacing: .28em; line-height: 2.1; color: var(--text); }
.tp-vert p { margin: 0; }
.tp-vert .ac { color: var(--cta); }

.tp-concept { padding: 120px 1.5rem 110px; display: flex; flex-direction: column; align-items: center; gap: 3rem; }
.tp-concept .tp-vert { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
.tp-concept-lead { max-width: 640px; text-align: center; font-size: 1rem; line-height: 2.3; letter-spacing: .08em; margin: 0; }

.tp-split { display: grid; grid-template-columns: 1fr 1.6fr; min-height: 560px; }
.tp-split-panel { position: relative; background: var(--brand); display: flex; align-items: center; justify-content: center; padding: 4rem 2rem; }
.tp-vert--sm { font-size: clamp(1.15rem, 1.8vw, 1.5rem); }
.tp-split-panel .ac2 { color: #fff; }
.tp-split-edge { position: absolute; top: 0; right: -59px; width: 60px; height: 100%; z-index: 1; }
.tp-split-edge path { fill: var(--brand); }
.tp-split-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
@media (max-width: 760px) { .tp-split { grid-template-columns: 1fr; } .tp-split-edge { display: none; } .tp-split-photo img { aspect-ratio: 4/3; } }

.tp-entry-wrap { padding: 110px 1.5rem; }
.tp-entry { max-width: 1120px; margin: 0 auto; border: 3px solid var(--cta); border-radius: 28px; background: #fff; display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 2rem; padding: 2.2rem 3rem; }
.tp-entry-sub { margin: 0 0 .4rem; font-size: .9rem; letter-spacing: .1em; color: var(--muted); }
.tp-entry-ttl { margin: 0; font-size: clamp(1.6rem, 2.8vw, 2.2rem); letter-spacing: .12em; color: var(--cta); }
.tp-entry-items { display: flex; justify-content: space-around; gap: 1rem; }
.tp-egg-link { display: flex; flex-direction: column; align-items: center; gap: .8rem; text-decoration: none; color: inherit; transition: transform .25s; }
.tp-egg-link:hover { transform: translateY(-5px); }
.tp-egg { width: clamp(110px, 12vw, 160px); aspect-ratio: 4/5; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; overflow: hidden; background: var(--peach); box-shadow: 0 8px 20px rgba(0,0,0,.12); }
.tp-egg img { width: 100%; height: 100%; object-fit: cover; display: block; }
.tp-egg-label { font-weight: 700; font-size: 1rem; letter-spacing: .06em; }
@media (max-width: 860px) { .tp-entry { grid-template-columns: 1fr; text-align: center; padding: 2rem 1.2rem; } .tp-egg { width: 92px; } .tp-egg-label { font-size: .85rem; } }

.tp-lineup { padding: 110px 1.5rem; background: #fff; }
.tp-lineup--biz { background: var(--bg); }
.tp-lineup-head { text-align: center; margin: 0 auto 3.5rem; max-width: 720px; }
.tp-lineup-sub { margin: 0 0 .6rem; color: var(--cta-text); font-weight: 700; letter-spacing: .1em; }
.tp-lineup-ttl { margin: 0 0 1.2rem; font-size: clamp(1.8rem, 3.4vw, 2.6rem); letter-spacing: .12em; }
.tp-lineup-lead { margin: 0; line-height: 2.1; color: var(--muted); }
.tp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem 2.5rem; max-width: 1120px; margin: 0 auto; }
.tp-grid--4 { grid-template-columns: repeat(4, 1fr); gap: 2.5rem 1.8rem; }
.tp-card-img { display: block; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: var(--bg); }
.tp-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
.tp-card-img:hover img { transform: scale(1.04); }
.tp-card h3 { margin: 1.2rem 0 .5rem; font-size: 1.08rem; line-height: 1.7; text-align: center; }
.tp-card-desc { margin: 0 0 1.2rem; font-size: .95rem; line-height: 1.9; color: var(--muted); }
.tp-card-price { margin: 0 0 1.2rem; text-align: center; }
.tp-card-price strong { font-family: Manrope, sans-serif; font-size: 1.6rem; font-weight: 600; }
.tp-card-price small { font-size: .82rem; color: var(--muted); margin-left: .3rem; }
.tp-card-btns { display: flex; gap: .6rem; justify-content: center; flex-wrap: wrap; }
.tp-btn { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-width: 8.5rem; padding: .75rem 1.3rem; border-radius: 999px; font-weight: 700; font-size: .92rem; letter-spacing: .04em; text-decoration: none; transition: background .2s, transform .2s; }
.tp-btn:hover { transform: translateY(-2px); }
.tp-btn--red { background: var(--cta); color: #fff; }
.tp-btn--red:hover { background: var(--cta-hv); }
.tp-btn--gold { background: var(--brand); color: var(--text); }
.tp-btn--gold:hover { background: var(--brand-hv); }
.tp-btn--line { background: #fff; color: var(--text); border: 2px solid var(--text); padding: .85rem 2.2rem; font-size: 1rem; }
.tp-more { text-align: center; margin-top: 3.5rem; }
.tp-metrics { list-style: none; margin: 4rem auto 0; padding: 0; max-width: 1120px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
.tp-metrics li { display: flex; flex-direction: column; align-items: center; gap: .3rem; padding: 1.2rem .5rem; background: #fff; border-radius: 16px; }
.tp-metric-num { font-family: Manrope, sans-serif; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 600; color: var(--cta); line-height: 1.2; }
.tp-metric-num small { font-size: .9rem; margin-left: .15rem; color: var(--text); }
.tp-metric-label { font-size: .9rem; color: var(--muted); }
@media (max-width: 960px) { .tp-grid, .tp-grid--4 { grid-template-columns: repeat(2, 1fr); } .tp-metrics { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .tp-grid { grid-template-columns: 1fr; } .tp-grid--4 { grid-template-columns: repeat(2, 1fr); gap: 2rem 1rem; } .tp-card-desc { font-size: .88rem; } .tp-lineup { padding: 80px 1.2rem; } }

.tp-about { padding: 110px 0 0; }
.tp-about-photo { max-width: 1340px; margin: 0 auto; padding: 0 1.5rem; }
.tp-about-photo img { width: 100%; aspect-ratio: 21/8; object-fit: cover; border-radius: 20px; display: block; }
.tp-about-body { max-width: 1040px; margin: 4rem auto 5rem; padding: 0 1.5rem; display: grid; grid-template-columns: 1fr auto; gap: 4rem; align-items: start; }
.tp-about-text p { margin: 0 0 1.6rem; line-height: 2.3; letter-spacing: .06em; }
.tp-about-ttl { margin: 0; font-size: clamp(1.6rem, 2.8vw, 2.3rem); }
.tp-about-ttl .ln { display: block; }
.tp-about-row { position: relative; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
.tp-about-cell img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
