/* 業務用：たまらん堂の作りに合わせて組み直し（写真は細い枠、特長は白い丸） */
.tp-biz-intro { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3.5rem; align-items: center; margin-bottom: 5rem; }
.tp-biz-frame { background: #fff; border: 2px solid var(--cta); border-radius: 14px; padding: 12px; }
