@media (max-width: 760px) { .tp-about-body { grid-template-columns: 1fr; gap: 2rem; } .tp-about-ttl { order: -1; justify-self: center; } .tp-about-photo img { aspect-ratio: 4/3; } }

/* 直売所 */
.blob { position: relative; overflow: hidden; }
.blob > * { position: relative; z-index: 1; }
.blob::before, .blob::after { content: ''; position: absolute; z-index: 0; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; pointer-events: none; }
.blob::before { width: 380px; height: 470px; left: -130px; bottom: -170px; background: var(--butter); transform: rotate(-16deg); }
.blob::after { width: 300px; height: 380px; right: -100px; top: -150px; background: var(--peach); transform: rotate(20deg); }
.wide { max-width: 1180px; }
.store-in { max-width: 860px; margin: 0 auto; text-align: center; }
.store-dl { display: grid; grid-template-columns: 8rem 1fr; text-align: left; margin: 0 0 2rem; background: #fff; border-radius: 16px; border: .5px solid var(--border); overflow: hidden; }
.store-dl dt, .store-dl dd { margin: 0; padding: 1.1rem 1.5rem; border-bottom: 1px solid var(--border); }
.store-dl dt { font-weight: 700; background: #FFF8DC; }
.store-dl dt:nth-last-of-type(1), .store-dl dd:last-of-type { border-bottom: 0; }
.store-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
@media (max-width: 600px) { .store-dl { grid-template-columns: 1fr; } .store-dl dt { border-bottom: 0; padding-bottom: .2rem; } }
.news-list { list-style: none; margin: 0 auto; padding: 0; max-width: 860px; }
.news-list li { border-bottom: 1px solid var(--border); }
.news-list a { display: flex; gap: 1.2rem; align-items: center; padding: 1.2rem .5rem; text-decoration: none; color: inherit; flex-wrap: wrap; }
.news-list time { font-family: Manrope, sans-serif; color: var(--muted); font-size: .95rem; }
.news-cat { background: var(--amber-bg); font-size: .82rem; font-weight: 700; padding: .2rem .8rem; border-radius: 999px; }
.news-title { flex: 1; min-width: 12rem; font-weight: 500; }

/* ---- 細部の調整 ---- */
/* ヒーローの周りの卵形 */
.hero { overflow: hidden; }
.hero-egg { position: absolute; z-index: 1; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; pointer-events: none; }
.he1 { width: clamp(140px, 15vw, 230px); aspect-ratio: 4/5; left: calc(clamp(140px, 15vw, 230px) * -.45); top: 46%; background: var(--bg); transform: rotate(-12deg); }
.he2 { width: clamp(60px, 6vw, 92px); aspect-ratio: 4/5; left: 4%; bottom: 7%; background: var(--peach); transform: rotate(14deg); }
.he3 { width: clamp(150px, 16vw, 250px); aspect-ratio: 4/5; right: calc(clamp(150px, 16vw, 250px) * -.42); top: 22%; background: var(--bg); transform: rotate(16deg); }
.he4 { width: clamp(54px, 5vw, 80px); aspect-ratio: 4/5; right: 6%; bottom: 11%; background: var(--butter); transform: rotate(-10deg); }
@media (max-width: 640px) { .he1 { top: 55%; } .he2, .he4 { display: none; } .he3 { top: 30%; } }

/* 書体：見出しと縦書きは、丸みのあるゴシック */
.tp-vert, .tp-entry-ttl, .tp-lineup-ttl, .tp-about-ttl, .tp-card h3 { font-family: 'Zen Maru Gothic', 'Zen Kaku Gothic New', sans-serif; }
.tp-vert { font-weight: 500; letter-spacing: .22em; }
.tp-concept .tp-vert { font-size: clamp(1.5rem, 2.6vw, 2.1rem); }
.tp-entry-ttl, .tp-lineup-ttl { font-weight: 700; }
.tp-lineup-ttl { font-size: clamp(1.9rem, 3.4vw, 2.7rem); letter-spacing: .1em; }
.tp-lineup-sub { font-size: .95rem; }
.tp-about-ttl { font-weight: 700; font-size: clamp(1.7rem, 2.8vw, 2.4rem); }
.tp-card h3 { font-weight: 700; font-size: 1.1rem; }
.tp-concept-lead, .tp-about-text p, .tp-lineup-lead { font-size: 1rem; }

/* 商品カード */
.tp-card { display: flex; flex-direction: column; }
.tp-card-img { border-radius: 14px; box-shadow: 0 6px 18px rgba(0,0,0,.07); }
.tp-card-desc { flex: 1; }
.tp-card-btns { margin-top: auto; }
.tp-btn { box-shadow: 0 3px 10px rgba(0,0,0,.1); }
.tp-ic { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #fff; flex-shrink: 0; }
.tp-ic--arrow::before { content: ''; width: 5px; height: 5px; border-top: 2px solid var(--cta); border-right: 2px solid var(--cta); transform: translateX(-1px) rotate(45deg); }
.tp-btn--line { box-shadow: none; }

/* 余白とセクションの間隔 */
.tp-concept { padding: 130px 1.5rem 120px; }
.tp-entry-wrap { padding: 120px 1.5rem; }
.tp-lineup { padding: 120px 1.5rem; }
.tp-about { padding-top: 120px; }
.tp-about-body { margin: 4.5rem auto 6rem; }
@media (max-width: 640px) {
  .tp-concept { padding: 80px 1.2rem 72px; gap: 2.2rem; }
