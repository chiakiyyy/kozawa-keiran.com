@media (max-width: 640px) { .tp-concept .tp-vert { font-size: 1.8rem; } .tp-vert--sm { font-size: 1.35rem; } .tp-about-ttl { font-size: 1.8rem; } .tp-lineup-ttl { font-size: 1.75rem; } }
@media (max-width: 560px) { .tp-grid > * { min-width: 0; } .tp-btn { min-width: 0; padding: .8rem 1rem; font-size: .95rem; } .tp-grid--4 .tp-card-btns { width: 100%; } .tp-grid--4 .tp-btn { width: 100%; } .tp-card h3 { font-size: 1.05rem; } }

/* ---- TOP再構成（SEO・導線） ---- */
