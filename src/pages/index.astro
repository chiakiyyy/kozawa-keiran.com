@media (max-width: 560px) { .tp-biz-circles li { padding-top: .8rem; justify-content: center; } .tp-biz-circles h3 { white-space: normal; } }

/* お探しの内容：卵形の中に、イラストと文字を入れる／ホバーで、コロコロ揺れる */
.tp-entry-items { align-items: flex-end; }
.tp-egg-link { gap: 0; }
.tp-egg--illus { width: clamp(150px, 15vw, 190px); flex-direction: column; justify-content: flex-start; padding-top: 16%; overflow: visible; transform-origin: 50% 90%; }
.tp-egg-art { display: block; width: 62%; }
.tp-egg-art svg { width: 100%; height: auto; display: block; }
.tp-egg--illus .tp-egg-label { margin-top: .5rem; font-family: 'Zen Maru Gothic', 'Zen Kaku Gothic New', sans-serif; font-weight: 700; font-size: .98rem; letter-spacing: .04em; white-space: nowrap; color: var(--text); }
.tp-egg-link:hover { transform: none; }
.tp-egg-link:hover .tp-egg--illus, .tp-egg-link:focus-visible .tp-egg--illus { animation: egg-wobble .7s ease-in-out; }
@keyframes egg-wobble { 0% { transform: rotate(0); } 18% { transform: rotate(-9deg); } 36% { transform: rotate(7deg); } 54% { transform: rotate(-5deg); } 72% { transform: rotate(3deg); } 88% { transform: rotate(-1.5deg); } 100% { transform: rotate(0); } }
@media (prefers-reduced-motion: reduce) { .tp-egg-link:hover .tp-egg--illus { animation: none; } }
@media (max-width: 860px) { .tp-egg--illus { width: 100%; max-width: 108px; } .tp-egg--illus .tp-egg-label { font-size: .7rem; letter-spacing: 0; white-space: normal; text-align: center; line-height: 1.3; padding: 0 .3rem; } }
