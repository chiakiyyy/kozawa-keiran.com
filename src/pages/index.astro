@media (max-width: 640px) { .tp-biz { padding: 72px 1.2rem; } .tp-biz-points li { padding: 1.1rem 1.1rem; } }

/* 番号：目玉焼きの黄身の上に数字を載せる */
.tp-biz-num { width: 80px; height: 72px; border-radius: 0; background: url('/images/fried-egg.png') center / contain no-repeat; padding-bottom: 5px; font-size: 1.1rem; font-weight: 800; color: #643E2F; filter: drop-shadow(0 2px 5px rgba(0,0,0,.14)); }
