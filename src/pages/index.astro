.tp-biz-in { max-width: 1120px; margin: 0 auto; }
.tp-biz-head { text-align: center; max-width: 720px; margin: 0 auto 3.5rem; }
.tp-biz-body { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3.5rem; align-items: center; }
