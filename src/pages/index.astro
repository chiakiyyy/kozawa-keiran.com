.tp-biz-circles h3 { margin: .5rem 0 .4rem; font-family: 'Zen Maru Gothic', 'Zen Kaku Gothic New', sans-serif; font-weight: 700; font-size: 1.02rem; line-height: 1.5; }
.tp-biz-circles p { margin: 0; font-size: .85rem; line-height: 1.7; color: var(--muted); }
.tp-biz-circles .tp-biz-num { width: 64px; height: 58px; font-size: 1rem; background: radial-gradient(circle 14px at 50% 46%, #E39200 96%, transparent 100%), url('/images/fried-egg.png') center / contain no-repeat; filter: drop-shadow(0 1px 3px rgba(0,0,0,.18)); }
@media (max-width: 960px) { .tp-biz-circles { grid-template-columns: repeat(2, 1fr); max-width: 560px; margin: 0 auto; } }
@media (max-width: 760px) { .tp-biz-intro { grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem; } }
@media (max-width: 420px) { .tp-biz-circles { gap: .8rem; } .tp-biz-circles li { padding: .6rem .9rem; } .tp-biz-circles h3 { font-size: .88rem; } .tp-biz-circles p { font-size: .72rem; } .tp-biz-circles .tp-biz-num { width: 50px; height: 45px; font-size: .85rem; background: radial-gradient(circle 11px at 50% 46%, #E39200 96%, transparent 100%), url('/images/fried-egg.png') center / contain no-repeat; } }

@media (max-width: 560px) {
  .tp-lineup-ttl { font-size: 1.6rem; letter-spacing: .06em; }
