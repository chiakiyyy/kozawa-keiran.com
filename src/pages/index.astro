@media (max-width: 860px) { .tp-entry { grid-template-columns: 1fr; } .tp-egg-link { flex: 1 1 0; } .tp-egg--illus { width: 100%; } }
.tp-egg--illus { aspect-ratio: auto; height: clamp(205px, 18vw, 250px); }
