  .tp-biz-circles li { aspect-ratio: auto; border-radius: 999px; flex-direction: row; justify-content: flex-start; text-align: left; gap: .9rem; padding: .8rem 1.4rem .8rem .9rem; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: .9rem; }
  .tp-biz-circles .tp-biz-num { grid-row: 1 / 3; width: 54px; height: 49px; font-size: .9rem; background: radial-gradient(circle 12px at 50% 46%, #E39200 96%, transparent 100%), url('/images/fried-egg.png') center / contain no-repeat; }
  .tp-biz-circles h3 { margin: 0; font-size: .98rem; align-self: end; }
  .tp-biz-circles p { font-size: .82rem; align-self: start; }
}
@media (max-width: 860px) { .tp-entry > * { min-width: 0; } .tp-entry-items { gap: .5rem; } .tp-egg-link { flex: 1; min-width: 0; } .tp-egg { width: 100%; max-width: 92px; } .tp-egg-label { font-size: .78rem; text-align: center; line-height: 1.4; } }
/* 読みやすさ：スマホでは、3行以上になる説明文を左ぞろえにする */
@media (max-width: 640px) { .tp-concept-lead, .tp-lineup-lead { text-align: left; } }

/* お探しの内容：写真からイラストへ */
.tp-egg--illus { display: flex; align-items: center; justify-content: center; box-shadow: none; }
