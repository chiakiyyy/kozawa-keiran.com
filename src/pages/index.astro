/* 入口：卵型イラスト（文字入りの画像）をそのまま表示 */
.tp-egg--img { display: block; width: clamp(170px, 16vw, 220px); height: auto; aspect-ratio: auto; background: none; box-shadow: none; overflow: visible; transform-origin: 50% 90%; }
