---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { metrics, works } from '../data/works';
import { stores, storeCategories } from '../data/stores';
import { processSteps } from '../data/commitment';

const breakdown = storeCategories
  .map(c => ({ category: c, n: stores.filter(s => s.category === c).length }))
  .filter(b => b.n > 0);
const maxN = Math.max(...breakdown.map(b => b.n));

const strengths = [
  { num: '01', title: '当日夕方のお届け', body: '富山市内は、月・水・金の午前9:30までのご注文で、当日夕方にお届けします。' },
  { num: '02', title: '大量注文・急な増減にも対応', body: '1ケース（約10kg）から承ります。催事やイベントの数量変更も、事前のご相談で調整します。' },
  { num: '03', title: '規格・サイズをご指定いただけます', body: '10kg箱はLL・L・M・MS・Sの各サイズ。赤玉などの指定もご相談ください。' },
  { num: '04', title: '請求書払い（掛け売り）に対応', body: '法人・個人事業主様には、掛け売りに対応しています。詳しくはご相談ください。' },
  { num: '05', title: '自社便で品質を守る', body: '温度を管理し、自社便でお届けします。' },
  { num: '06', title: '100年以上の信頼', body: '大正時代の創業から、鶏卵ひと筋に歩んできました。' },
];
const targets = ['ラーメン店', '飲食店全般', '洋菓子・パン', 'ホテル', 'スーパー・小売', '給食施設・学校・病院', 'イベント・催事'];
---
<Layout title="卸売の実績｜小澤鶏卵" description="小澤鶏卵の卸売実績。飲食店・洋菓子店・ホテル・スーパー・給食施設・催事など、富山県内の様々な業態へたまごをお届けしています。">
  <Header/>
  <main>
    <PageHero en="Works" ja="卸売の実績" img="/images/business_hero.png" lead="100年以上にわたり、富山の食を支える事業者様へたまごをお届けしています。"/>

    <section class="sec">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Numbers</h2><p class="ttl-ja">数字で見る小澤鶏卵</p>
        </div>
        <div class="metric-grid">
          {metrics.map((m, i) => (
            <div class={`metric fade-up fade-up-d${i + 1}`}>
              <div class="metric-num">{m.num}<small>{m.unit}</small></div>
              <div class="metric-label">{m.label}</div>
              {m.note && <div class="metric-note">{m.note}</div>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--pale">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Case</h2><p class="ttl-ja">納品事例</p>
        </div>
        <div class="case-grid">
          {works.map((w, i) => (
            <article class={`card case-card fade-up fade-up-d${(i % 3) + 1}`}>
              <span class="case-cat">{w.category}</span>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </article>
          ))}
        </div>
        <div style="text-align:center;margin-top:3rem">
          <a href="#breakdown" class="btn-circle">取引先の内訳を見る</a>
        </div>
      </div>
    </section>


    <section class="sec" id="breakdown">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Breakdown</h2><p class="ttl-ja">取引先の内訳</p></div>
        <p class="wk-lead">現在お取引のある事業者を、業態別に集計しています。（店舗名は掲載していません）</p>
        <ul class="bk-list">
          {breakdown.map(b => (
            <li class="bk">
              <span class="bk-name">{b.category}</span>
              <span class="bk-bar"><i style={`width:${Math.round((b.n / maxN) * 100)}%`}></i></span>
              <span class="bk-n">{b.n}<small>件</small></span>
            </li>
          ))}
        </ul>
        <p class="wk-note">※2026年時点の集計。業態は事業内容にもとづく分類で、変更される場合があります。</p>
      </div>
    </section>

    <section class="sec sec--pale">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Strengths</h2><p class="ttl-ja">選ばれる理由</p></div>
        <div class="st-grid">
          {strengths.map(x => (
            <article class="st fade-up">
              <span class="st-num">{x.num}</span>
              <h3>{x.title}</h3>
              <p>{x.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Industries</h2><p class="ttl-ja">対応している業態</p></div>
        <ul class="ind-list">
          {targets.map(t => <li>{t}</li>)}
        </ul>
        <div style="text-align:center;margin-top:3rem">
          <a href="/business" class="btn-circle">法人のお客様はこちら</a>
        </div>
      </div>
    </section>

    <section class="sec sec--pale">
      <div class="container">
        <div class="ttl fade-up"><h2 class="ttl-en">Process</h2><p class="ttl-ja">品質を守る出荷の流れ</p></div>
        <ol class="wk-steps">
          {processSteps.map(st => (
            <li><span>{st.num}</span><div><h3>{st.title}</h3><p>{st.body}</p></div></li>
          ))}
        </ol>
        <div style="text-align:center;margin-top:3rem"><a href="/feature#process" class="btn-circle">こだわり・出荷の流れを見る</a></div>
      </div>
    </section>

    <ContactSection title="お取引のご相談" lead="業態・数量・配送のご希望をお聞かせください。お見積もりをご提案します。"/>
  </main>
  <Footer/>
</Layout>

<style>
.wk-lead { text-align: center; margin: -1.5rem 0 2.5rem; color: var(--muted); font-size: .92rem; }
.wk-note { text-align: center; font-size: .78rem; color: var(--muted); margin-top: 1.5rem; }
.bk-list { list-style: none; margin: 0 auto; padding: 0; max-width: 760px; display: grid; gap: 1.1rem; }
.bk { display: grid; grid-template-columns: 9rem 1fr 4rem; gap: 1.2rem; align-items: center; }
.bk-name { font-weight: 700; font-size: .95rem; }
.bk-bar { background: var(--panel); border-radius: 999px; height: 14px; overflow: hidden; display: block; }
.bk-bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--amber-lt), var(--amber)); border-radius: 999px; }
.bk-n { font-family: Manrope, sans-serif; font-size: 1.5rem; color: var(--amber); text-align: right; font-weight: 500; }
.bk-n small { font-size: .75rem; margin-left: .1rem; }
.st-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
.st { background: #fff; border-radius: 16px; padding: 2rem; border: .5px solid var(--border); }
.st-num { font-family: Manrope, sans-serif; font-weight: 300; font-size: 2rem; color: var(--amber); letter-spacing: .06em; }
.st h3 { margin: .4rem 0 .6rem; font-size: 1.05rem; line-height: 1.7; }
.st p { margin: 0; font-size: .9rem; line-height: 2; color: var(--muted); }
.ind-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }
.ind-list li { padding: .8rem 1.6rem; border: 1px solid rgba(186,117,23,.4); border-radius: 999px; color: var(--amber); font-weight: 700; font-size: .92rem; background: #fff; }
.wk-steps { list-style: none; margin: 0 auto; padding: 0; max-width: 760px; display: grid; gap: 1rem; }
.wk-steps li { display: flex; gap: 1.5rem; align-items: center; background: #fff; border-radius: 16px; padding: 1.2rem 1.8rem; border: .5px solid var(--border); }
.wk-steps li > span { font-family: Manrope, sans-serif; font-size: 1.5rem; font-weight: 300; color: var(--amber); min-width: 2.2rem; }
.wk-steps h3 { margin: 0 0 .2rem; font-size: 1rem; }
.wk-steps p { margin: 0; font-size: .88rem; color: var(--muted); }
@media (max-width: 860px) { .st-grid { grid-template-columns: 1fr 1fr; } .bk { grid-template-columns: 7rem 1fr 3.5rem; } }
@media (max-width: 600px) { .st-grid { grid-template-columns: 1fr; } }
.metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
.metric { text-align: center; padding: 2rem 1rem; border-top: 2px solid var(--amber-lt); background: var(--amber-pale); border-radius: 0 0 var(--radius-md) var(--radius-md); }
.metric-num { font-family: Manrope, sans-serif; font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 700; color: var(--amber); line-height: 1.2; }
.metric-num small { font-size: 1rem; margin-left: .2rem; }
.metric-label { font-size: .88rem; font-weight: 700; margin-top: .5rem; }
.metric-note { font-size: .76rem; color: var(--muted); margin-top: .25rem; }
.case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
.case-card { padding: 2rem; display: flex; flex-direction: column; gap: .8rem; }
.case-cat { align-self: flex-start; background: var(--amber-bg); color: var(--amber); font-size: .72rem; font-weight: 700; padding: .25rem .9rem; border-radius: 999px; letter-spacing: .06em; }
.case-card h3 { font-size: 1.02rem; margin: 0; line-height: 1.7; }
.case-card p { font-size: .83rem; color: var(--muted); line-height: 1.9; margin: 0; }
.case-card dl { display: grid; grid-template-columns: auto 1fr; gap: .3rem .9rem; font-size: .76rem; margin: .5rem 0 0; padding-top: 1rem; border-top: .5px solid var(--border); }
.case-card dt { color: var(--amber); font-weight: 700; }
.case-card dd { margin: 0; }
@media (max-width: 960px) { .metric-grid { grid-template-columns: repeat(2, 1fr); } .case-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .case-grid { grid-template-columns: 1fr; } }
</style>
