---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

// ひな形です。公開前に、実際の取り扱い（委託先・保管場所・窓口）と一致しているか、必ず確認してください。
const sections = [
  { h: '1. 基本方針', p: ['小澤鶏卵（以下「当店」）は、お客様の個人情報の大切さを認識し、個人情報の保護に関する法令を守り、適切に取り扱います。'] },
  { h: '2. 取得する個人情報', p: ['当店は、次の場面で、お客様の個人情報をお預かりします。'], ul: [
    'お問い合わせ：会社名・店舗名、お名前、メールアドレス、電話番号、お問い合わせの内容',
    'ギフト等のご注文：ご依頼主・お届け先のお名前、電話番号、住所、メールアドレス、のし・メッセージなどのご希望',
  ] },
  { h: '3. 利用目的', p: ['お預かりした個人情報は、次の目的の範囲でのみ利用します。'], ul: [
    'お問い合わせへの回答、ご連絡',
    '商品の発送、お支払いの手続き、ご注文に関するご連絡',
    '取引に関するご案内、ご連絡',
    '法令にもとづく対応',
  ] },
  { h: '4. 第三者への提供', p: ['当店は、次の場合を除き、お客様の同意なく個人情報を第三者に提供しません。'], ul: [
    '法令にもとづく場合',
    '人の生命・身体・財産の保護のために必要で、同意を得ることが難しい場合',
    '下記「5. 業務の委託・外部サービスの利用」に記載する場合',
  ] },
  { h: '5. 業務の委託・外部サービスの利用', p: ['当店は、業務のために、次の外部サービスを利用し、必要な範囲で個人情報を取り扱わせます。'], ul: [
    'お問い合わせ・ご注文フォームの内容の受付・保管：Google（Google Apps Script、Googleスプレッドシート）',
    'お支払い：Square、楽天ペイ（クレジットカード番号などは、当サイトでは取得せず、各サービスの画面で入力していただきます）',
    '商品の配送：配送事業者（お届け先のお名前・住所・電話番号をお伝えします）',
    'Webフォントの配信：Google Fonts（閲覧時に、IPアドレスなどがGoogleに送信される場合があります）',
  ] },
  { h: '6. 安全管理', p: ['当店は、個人情報の漏えい、滅失、毀損を防ぐため、アクセスできる者を必要最小限に限るなど、適切な安全管理を行います。'] },
  { h: '7. 開示・訂正・削除などのご請求', p: ['お客様ご本人から、当店が保有する個人情報の開示、訂正、利用停止、削除のご請求があった場合は、ご本人であることを確認のうえ、法令にもとづき対応します。下記の窓口までご連絡ください。'] },
  { h: '8. アクセス解析・Cookie', p: ['当サイトは、現時点でアクセス解析ツールや広告用のCookieを使用していません。導入する場合は、本ポリシーに記載します。'] },
  { h: '9. ポリシーの変更', p: ['当店は、必要に応じて、本ポリシーを見直し、変更します。変更後の内容は、このページに掲載します。'] },
];
---
<Layout title="プライバシーポリシー｜小澤鶏卵" description="小澤鶏卵のプライバシーポリシー（個人情報の取り扱いについて）です。">
  <Header/>
  <main>
    <PageHero en="Privacy" ja="プライバシーポリシー" img="/images/shop/point1.jpg"/>
    <section class="sec">
      <div class="container nrw">
        <p class="lead">個人情報の取り扱いについて、次のとおりお知らせします。</p>
        {sections.map(s => (
          <section class="pv">
            <h2>{s.h}</h2>
            {s.p.map(t => <p>{t}</p>)}
            {s.ul && <ul>{s.ul.map(i => <li>{i}</li>)}</ul>}
          </section>
        ))}
        <section class="pv">
          <h2>10. お問い合わせ窓口</h2>
          <dl class="co">
            <dt>事業者</dt><dd>小澤鶏卵（代表 小澤 龍生）</dd>
            <dt>所在地</dt><dd>〒939-2716 富山県富山市婦中町下轡田25-1</dd>
            <dt>電話</dt><dd><a href="tel:076-466-3815">076-466-3815</a>（月〜土 8:00〜17:00）</dd>
            <dt>メール</dt><dd><a href="mailto:info@kozawa-keiran.com">info@kozawa-keiran.com</a></dd>
          </dl>
        </section>
        <p class="date">2026年10月26日 制定</p>
      </div>
    </section>
  </main>
  <Footer/>
</Layout>

<style>
.nrw { max-width: 820px; }
.lead { margin: 0 0 2.5rem; color: var(--muted); }
.pv { margin: 0 0 2.2rem; }
.pv h2 { font-size: 1.1rem; margin: 0 0 .7rem; padding-left: .8rem; border-left: 3px solid var(--amber-lt); }
.pv p, .pv li { font-size: .95rem; line-height: 2.1; }
.pv p { margin: 0 0 .6rem; }
.pv ul { margin: .3rem 0 0; padding-left: 1.4rem; }
.co { display: grid; grid-template-columns: 6rem 1fr; gap: .4rem 1rem; margin: 0; font-size: .95rem; }
.co dt { color: var(--amber); font-weight: 700; } .co dd { margin: 0; }
.co a { color: var(--amber); text-decoration: underline; }
.date { text-align: right; color: var(--muted); font-size: .85rem; margin-top: 2.5rem; }
</style>
