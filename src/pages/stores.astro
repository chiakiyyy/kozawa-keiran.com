---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { stores, storeCategories } from '../data/stores';

const grouped = storeCategories
  .map(c => {
    const items = stores.filter(s => s.category === c);
    const areas = [...new Set(items.map(s => s.area))].map(area => ({ area, n: items.filter(s => s.area === area).length }));
    return { category: c, items, areas };
  })
  .filter(g => g.items.length > 0);
---
<Layout title="取扱店舗一覧｜小澤鶏卵" description="小澤鶏卵のたまごをお取り扱いいただいている飲食店・洋菓子店・ホテル・スーパー・施設の一覧です。">
  <Header/>
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="page-hero-label">STORES</span>
        <h1 class="page-hero-title">取扱店舗一覧</h1>
        <p class="page-hero-sub">小澤鶏卵のたまごをお使いいただいている取引先を、業態とエリア別にご紹介します。</p>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <nav class="st-tabs" aria-label="業態で絞り込む">
          <button class="st-tab active" data-cat="all">すべて</button>
          {grouped.map(g => <button class="st-tab" data-cat={g.category}>{g.category}</button>)}
        </nav>

        {grouped.map(g => (
          <section class="st-group" data-cat={g.category}>
            <h2 class="st-group-title">{g.category}<span class="st-count">{g.items.length}件</span></h2>
            <ul class="st-areas">
              {g.areas.map(a => <li class="st-area-chip">{a.area}<span>{a.n}</span></li>)}
            </ul>
          </section>
        ))}

        <p class="st-foot">※取引先のプライバシー保護のため、店舗名は掲載していません。件数は2026年時点の取引先の集計で、変更される場合があります。</p>
      </div>
    </section>

    <section class="sec sec--amber">
      <div class="container" style="text-align:center">
        <h2 class="sec-title">取扱店舗になりませんか？</h2>
        <p class="sec-lead">飲食店・小売店・施設のみなさま、卸売のお取引を承ります。</p>
        <a href="/business" class="btn btn-primary" style="margin-top:1.75rem">法人のお客様はこちら →</a>
      </div>
    </section>

    <ContactSection/>
  </main>
  <Footer/>
</Layout>

<style>
.st-tabs { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; margin-bottom: 3rem; }
.st-tab { padding: .55rem 1.3rem; border: 1px solid rgba(186,117,23,.4); border-radius: 999px; background: #fff; color: var(--amber); font-size: .82rem; font-weight: 700; cursor: pointer; font-family: inherit; transition: all .2s; }
.st-tab:hover, .st-tab.active { background: var(--amber); color: #FFFBF3; }
.st-group { margin-bottom: 2.5rem; }
.st-group[hidden] { display: none; }
.st-group-title { font-size: 1.1rem; padding-left: .9rem; border-left: 3px solid var(--amber-lt); margin: 0 0 1rem; }
.st-count { margin-left: .8rem; font-size: .8rem; font-weight: 700; color: var(--amber); }
.st-areas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
.st-area-chip { display: inline-flex; align-items: center; gap: .6rem; padding: .6rem 1.2rem; border: 1px solid var(--border); border-radius: 999px; background: #fff; font-size: .88rem; font-weight: 700; }
.st-area-chip span { background: var(--amber-bg); color: var(--amber); border-radius: 999px; padding: .1rem .6rem; font-size: .75rem; }
.st-foot { font-size: .75rem; color: var(--muted); text-align: center; margin-top: 2rem; }
</style>

<script>
const tabs = document.querySelectorAll<HTMLButtonElement>('.st-tab');
const groups = document.querySelectorAll<HTMLElement>('.st-group');
tabs.forEach(tab => tab.addEventListener('click', () => {
  tabs.forEach(t => t.classList.toggle('active', t === tab));
  const cat = tab.dataset.cat;
  groups.forEach(g => { g.hidden = cat !== 'all' && g.dataset.cat !== cat; });
}));
</script>
